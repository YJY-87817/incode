{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "font-awesome@7.0.1",
      "destination": "wwwroot/lib/font-awesome/"
    },
    {
      "library": "datatables@2.2.1",
      "destination": "wwwroot/lib/datatables/",
      "files": [
        "css/dataTables.bootstrap5.min.css",
        "js/dataTables.min.js",
        "js/dataTables.bootstrap5.min.js"
      ]
    },
    {
      "library": "Chart.js@4.5.0",
      "destination": "wwwroot/lib/chart.js/",
      "files": [
        "chart.umd.min.js"
      ]
    },
    {
      "library": "jquery-easing@1.4.1",
      "destination": "wwwroot/lib/jquery-easing/"
    }
  ]
}