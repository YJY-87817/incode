@model List<incode2.ViewModels.PointLogsViewModel>

@{
    ViewData["Title"] = "後台 - 使用者點數明細";
}

<div class="container-fluid py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-person-lines-fill text-primary me-2"></i>點數明細查詢</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="bi bi-arrow-left"></i> 回日誌列表
        </a>
    </div>

    <div class="card shadow mb-4 border-left-primary">
        <div class="card-body">
            <form asp-action="PointLogsDetail" method="get" class="row g-3 align-items-end">
                <div class="col-lg-5 col-md-6">
                    <label class="form-label fw-bold text-primary"><i class="bi bi-search me-1"></i>搜尋使用者</label>
                    <select name="UserId" class="form-select form-select-lg" asp-items="ViewBag.UserList">
                        <option value="">-- 請輸入關鍵字搜尋 --</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-4">
                    <button type="submit" class="btn btn-primary btn-sm w-50 shadow">
                        <i class="bi bi-search"></i> 查詢明細
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.SelectedUserId != null)
    {
        <div class="row mb-4">
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">當前帳戶餘額</div>
                                <div class="h3 mb-0 font-weight-bold text-gray-800">
                                    @((ViewBag.CurrentTotalPoints ?? 0).ToString("N0")) <small class="text-muted">點</small>
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-wallet2 fs-1 text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-8 col-md-6 mb-4 d-flex align-items-center">
                <div class="alert alert-info border-0 shadow-sm w-100 mb-0">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    查看使用者 ID：<strong>@ViewBag.SelectedUserId</strong> 的明細 (按時間新到舊排序)
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card shadow">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-dark">
                                <tr>
                                    <th class="text-center" style="width: 150px;">異動時間</th>
                                    <th class="text-center">類別</th>
                                    <th class="text-start">描述</th>
                                    <th class="text-end">異動金額</th>
                                    <th class="text-end" style="width: 150px;">餘額</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center small text-muted">
                                            @item.CreatedAt.ToString("yyyy-MM-dd")<br />
                                            <span class="fw-bold text-dark">@item.CreatedAt.ToString("HH:mm:ss")</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary rounded-pill px-3">@item.DisplayName</span>
                                        </td>
                                        <td class="text-start">
                                            <div class="fw-bold text-dark">@item.Description</div>
                                        </td>
                                        <td class="text-end fw-bold fs-6 @item.ChangeAmountCss">
                                            @item.FormattedChangeAmount
                                        </td>
                                        <td class="text-end fw-bold text-secondary">
                                            @item.FormattedNewBalance
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 shadow-sm bg-white rounded">
                <i class="bi bi-inbox display-4 text-gray-300"></i>
                <p class="mt-3 text-gray-500">此使用者尚無任何點數異動紀錄</p>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 shadow-sm bg-white rounded border-dashed">
            <i class="bi bi-person-check display-4 text-gray-300"></i>
            <p class="mt-3 text-gray-500">請從上方選擇使用者以載入數據</p>
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            // 初始化下拉選單搜尋功能
            $('select[name="UserId"]').select2({
                placeholder: "-- 請輸入 ID、姓名或 Email 搜尋 --",
                allowClear: true,
                width: '100%'
            });

            // 保持選取狀態
            const selectedId = "@ViewBag.SelectedUserId";
            if (selectedId) {
                $('select[name="UserId"]').val(selectedId).trigger('change');
            }
        });
    </script>
}

<style>
    .border-left-primary {
        border-left: 0.25rem solid #4e73df !important;
    }

    .border-left-success {
        border-left: 0.25rem solid #1cc88a !important;
    }

    .border-dashed {
        border: 2px dashed #e3e6f0;
    }

    .text-gray-300 {
        color: #dddfeb !important;
    }

    .text-gray-500 {
        color: #858796 !important;
    }

    .text-gray-800 {
        color: #5a5c69 !important;
    }
</style>