@model IEnumerable<incode2.Models.PointLog>

@{
    ViewData["Title"] = "點數流水帳管理";
}

<div class="container-fluid py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-coins text-warning me-2"></i>點數異動日誌</h1>
        <div>
            @* 修正 Action 名稱 matching: PointLogsDetail *@
            <a asp-action="PointLogsDetail" class="btn btn-sm btn-info shadow-sm">
                <i class="fas fa-search fa-sm text-white-50"></i> 詳細分析視圖
            </a>
            <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm ms-2">
                <i class="fas fa-plus fa-sm text-white-50"></i> 手動調整點數
            </a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h6 class="m-0 font-weight-bold text-primary">點數流水紀錄表</h6>
                </div>
                <div class="col-auto">
                    <span class="badge badge-pill badge-light border text-muted">
                        <i class="fas fa-info-circle me-1"></i>共 @Model.Count() 筆紀錄
                    </span>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="pointLogTable" width="100%" cellspacing="0">
                    <thead class="table-light text-center">
                        <tr>
                            <th style="width: 15%">時間</th>
                            <th style="width: 15%">用戶</th>
                            <th style="width: 10%">類別</th>
                            <th>來源描述</th>
                            <th style="width: 10%">異動金額</th>
                            <th style="width: 10%">餘額</th>
                            <th style="width: 8%">狀態</th>
                            <th style="width: 8%">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center small">
                                    @item.CreatedAt?.ToString("yyyy/MM/dd HH:mm:ss")
                                </td>
                                <td>
                                    <div class="fw-bold">@item.User?.Email.Split('@')[0]</div>
                                    <small class="text-muted">@item.User?.Email</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@item.PointTypeDefinition?.Category</span>
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="badge badge-light border text-dark">@item.SourceType</span>
                                        <strong>@item.DisplaySource</strong>
                                    </div>
                                    <div class="text-muted extra-small mt-1">@item.DisplaySourceSubTitle</div>
                                </td>
                                <td class="text-end font-weight-bold">
                                    @if (item.ChangeAmount >= 0)
                                    {
                                        <span class="text-success">+@item.ChangeAmount.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@item.ChangeAmount.ToString("N0")</span>
                                    }
                                </td>
                                <td class="text-center font-weight-bold text-dark">
                                    @item.BalanceAfter.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "completed" || item.Status == "1")
                                    {
                                        <span class="badge bg-success shadow-sm">成功</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark shadow-sm">@item.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-action="PointLogsDetail"
                                           asp-route-userId="@item.UserId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="查看 @item.User?.Username 的完整點數明細">
                                            <i class="fas fa-users"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.PointLogId" class="btn btn-sm btn-outline-info" title="查看詳情">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.PointLogId" class="btn btn-sm btn-outline-primary" title="編輯紀錄">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#pointLogTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/zh-HANT.json"
                },
                "order": [[0, "desc"]],
                "pageLength": 25,
                "columnDefs": [
                    { "orderable": false, "targets": [7] } // 禁止操作欄位排序
                ]
            });
        });
    </script>
}

<style>
    .extra-small {
        font-size: 0.75rem;
    }
    /* 使用 Bootstrap 5 類別或是自定義 text-end */
    .text-end {
        text-align: right;
        padding-right: 1rem !important;
    }

    #pointLogTable thead th {
        vertical-align: middle;
    }
</style>