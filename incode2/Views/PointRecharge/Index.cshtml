@model IEnumerable<incode2.Models.PointRecharge>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CashAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PointsGranted)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentMethod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RelatedOrderId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.OrderNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CashAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PointsGranted)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentMethod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RelatedOrderId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Account)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PointRechargeId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PointRechargeId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PointRechargeId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
