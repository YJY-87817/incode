@model IEnumerable<incode2.Models.PointRecharge>

@{
    ViewData["Title"] = "點數儲值管理";
}

<div class="container-fluid py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-dollar-sign text-primary me-2"></i>點數儲值紀錄
        </h1>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> 新增儲值紀錄
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">儲值明細列表</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.OrderNo)</th>
                            <th>@Html.DisplayNameFor(model => model.CashAmount)</th>
                            <th>@Html.DisplayNameFor(model => model.PointsGranted)</th>
                            <th>@Html.DisplayNameFor(model => model.PaymentMethod)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                            <th>會員 Email</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.OrderNo)</td>
                                <td>@item.CashAmount.ToString("C0")</td>
                                <td class="fw-bold">@item.PointsGranted.ToString("N0")</td>
                                <td>@Html.DisplayFor(modelItem => item.PaymentMethod)</td>
                                <td>
                                    @if (item.Status == "Success")
                                    {
                                        <span class="badge bg-success">成功</span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">處理中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                </td>
                                <td>@item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @{
                                        // 處理 Email，只顯示 @ 前面的部分
                                        var emailPrefix = item.User?.Email?.Split('@')[0] ?? "N/A";
                                    }
                                    @emailPrefix
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.PointRechargeId" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.PointRechargeId" class="btn btn-outline-info btn-sm">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.PointRechargeId" class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 初始化 DataTables
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/zh-HANT.json"
                },
                "order": [[5, "desc"]] // 預設依建立時間倒序排序
            });
        });
    </script>
}