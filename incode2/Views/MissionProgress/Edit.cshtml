@model incode2.Models.MissionProgress

@{
    ViewData["Title"] = "編輯任務進度";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-white py-3">
            <h4 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>編輯任務進度 - ID: @Model.MissionProgressId</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* 唯讀欄位：ID (需要放在 form 裡以便提交到 Controller) *@
                <input type="hidden" asp-for="MissionProgressId" />

                @* 關聯選擇 *@
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="UserId" class="form-label fw-bold text-secondary">會員</label>
                        @* 關聯通常設為唯讀，不允許在編輯進度時更換會員 *@
                        <div class="form-control-plaintext bg-light border rounded px-2">
                            @(ViewBag.UserEmail ?? "未知") @* 假設Controller傳入UserEmail *@
                        </div>
                        <input type="hidden" asp-for="UserId" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MissionId" class="form-label fw-bold text-secondary">任務</label>
                        @* 任務通常設為唯讀 *@
                        <div class="form-control-plaintext bg-light border rounded px-2">
                            @(ViewBag.MissionName ?? "未知") @* 假設Controller傳入MissionName *@
                        </div>
                        <input type="hidden" asp-for="MissionId" />
                    </div>
                </div>

                @* 進度與狀態 *@
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="CurrentCount" class="form-label fw-bold text-secondary">當前進度數量</label>
                        <input asp-for="CurrentCount" type="number" class="form-control" />
                        <span asp-validation-for="CurrentCount" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-bold text-secondary">狀態 <span class="text-danger">*</span></label>
                        @* 改為下拉選單 *@
                        <select asp-for="Status" class="form-select" required>
                            <option value="ongoing" selected="@(Model.Status == "ongoing")">進行中</option>
                            <option value="completed" selected="@(Model.Status == "completed")">已完成</option>
                            <option value="rewarded" selected="@(Model.Status == "rewarded")">已領獎</option>
                            <option value="failed" selected="@(Model.Status == "failed")">已失敗</option>
                            <option value="cancelled" selected="@(Model.Status == "cancelled")">已取消</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4 text-muted">
                <h5 class="mb-3 text-primary"><i class="bi bi-calendar-event me-2"></i>時間追蹤</h5>

                @* 時間欄位：建議唯讀或隱藏，通常由系統自動處理 *@
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="AcceptedAt" class="form-label fw-bold text-secondary">接取時間</label>
                        <input asp-for="AcceptedAt" type="datetime-local" class="form-control" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CompletedAt" class="form-label fw-bold text-secondary">完成時間</label>
                        <input asp-for="CompletedAt" type="datetime-local" class="form-control" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RewardedAt" class="form-label fw-bold text-secondary">領獎時間</label>
                        <input asp-for="RewardedAt" type="datetime-local" class="form-control" readonly />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="CycleStartAt" class="form-label fw-bold text-secondary">週期開始時間</label>
                        <input asp-for="CycleStartAt" type="datetime-local" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CycleEndAt" class="form-label fw-bold text-secondary">週期結束時間</label>
                        <input asp-for="CycleEndAt" type="datetime-local" class="form-control" readonly />
                    </div>
                </div>

                <div class="mt-5 d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm">
                        <i class="bi bi-save me-2"></i>儲存修改
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-arrow-left me-2"></i>返回列表
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}