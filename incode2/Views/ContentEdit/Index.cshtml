@using System.Text
@model IEnumerable<incode2.ViewModels.ContentEditViewModel>

<div class="table-responsive">
  <table class="table table-bordered" width="100%">
    <thead>
      <tr>
        <th>ContentId</th>
        <th>ParentContentId</th>
        <th>CategoryId</th>
        <th>UserId</th>
        <th>Title</th>
        <th>Body</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var item in Model)
      {
        <tr>
          <td>
            <strong>@item.ContentId</strong>
          </td>
          <td>
            @item.ParentContentId
          </td>
          <td>
            @item.CategoryId
          </td>
          <td>
            <span class="badge badge-primary">@item.UserId</span>
          </td>
          <td>
            @item.Body
          </td>
          <td>
            <a asp-action="Details" asp-route-id="@item.ContentId"
               class="btn btn-info btn-sm">
              <i class="fas fa-eye"></i> 查看
            </a>
          </td>
        </tr>
      }

    </tbody>
  </table>
</div>
