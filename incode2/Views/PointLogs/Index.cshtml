@model IEnumerable<incode2.Models.PointLog>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SourceType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SourceId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PointTypeDefinition)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChangeAmount)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.BalanceAfter)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>           
            <th>
                會員明細
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.User.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SourceType )
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SourceId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PointTypeDefinition.DisplayName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ChangeAmount)
            </td>
            @* <td>
                @Html.DisplayFor(modelItem => item.BalanceAfter)
            </td> *@
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                <a asp-action="PointLogsDetail" asp-route-userId="@item.UserId" class="btn btn-sm btn-info">
                        查看此會員明細
                </a>
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-PointLogId="@item.PointLogId">Edit</a> |
                <a asp-action="Details" asp-route-PointLogId="@item.PointLogId">Details</a> |
                <a asp-action="Delete" asp-route-PointLogId="@item.PointLogId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
