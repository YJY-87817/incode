@model incode2.Models.Mission

@{
    ViewData["Title"] = "編輯平台任務";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning py-3">
            <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>編輯平台任務 - @Model.MissionName</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="MissionId" />

                @* 任務基本資訊 *@
                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label asp-for="MissionName" class="form-label fw-bold text-secondary">任務名稱 <span class="text-danger">*</span></label>
                        <input asp-for="MissionName" class="form-control" required />
                        <span asp-validation-for="MissionName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label fw-bold text-secondary">類別</label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="MissionDetail" class="form-label fw-bold text-secondary">任務詳情</label>
                    <textarea asp-for="MissionDetail" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="MissionDetail" class="text-danger"></span>
                </div>

                <hr class="my-4 text-muted">
                <h5 class="mb-3 text-primary"><i class="bi bi-gear me-2"></i>設定與獎勵</h5>

                @* 任務設定 *@
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label asp-for="TargetType" class="form-label fw-bold text-secondary">目標類型</label>
                        <input asp-for="TargetType" class="form-control" />
                        <span asp-validation-for="TargetType" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="TargetCount" class="form-label fw-bold text-secondary">目標數量</label>
                        <input asp-for="TargetCount" type="number" class="form-control" />
                        <span asp-validation-for="TargetCount" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Difficulty" class="form-label fw-bold text-secondary">難度</label>
                        <input asp-for="Difficulty" class="form-control" />
                        <span asp-validation-for="Difficulty" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EstimatedDuration" class="form-label fw-bold text-secondary">預計時長</label>
                        <input asp-for="EstimatedDuration" class="form-control" />
                        <span asp-validation-for="EstimatedDuration" class="text-danger"></span>
                    </div>
                </div>

                @* 獎勵設定 *@
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="RewardPoints" class="form-label fw-bold text-secondary">獎勵點數</label>
                        <div class="input-group">
                            <input asp-for="RewardPoints" type="number" class="form-control" />
                            <span class="input-group-text">Pts</span>
                        </div>
                        <span asp-validation-for="RewardPoints" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RewardExp" class="form-label fw-bold text-secondary">獎勵經驗</label>
                        <input asp-for="RewardExp" type="number" class="form-control" />
                        <span asp-validation-for="RewardExp" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ResetType" class="form-label fw-bold text-secondary">重置類型</label>
                        <input asp-for="ResetType" class="form-control" />
                        <span asp-validation-for="ResetType" class="text-danger"></span>
                    </div>
                </div>

                @* 狀態與系統欄位 *@
                <div class="row g-3 mb-4 p-3 bg-light rounded border">
                    <div class="col-md-3">
                        <label asp-for="ParticipantCount" class="form-label fw-bold text-secondary">參與人數</label>
                        <input asp-for="ParticipantCount" type="number" class="form-control" readonly />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="LastResetAt" class="form-label fw-bold text-secondary">上次重置時間</label>
                        <input asp-for="LastResetAt" type="datetime-local" class="form-control" readonly />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch me-4">
                            <input type="checkbox" name="IsActive" value="true" @(Model.IsActive == true ? "checked" : "") class="form-check-input" />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label fw-bold" for="IsActiveSwitch">啟用狀態</label>
                        </div>
                        <div class="form-check form-switch">
                            @* 用隱藏欄位確保如果沒勾選，後端收到 false *@
                            <input type="hidden" name="IsFeatured" value="false" />

                            @* 檢查屬性是否為 true *@
                            <input type="checkbox" name="IsFeatured" value="true" class="form-check-input" id="IsFeaturedSwitch" @(Model.IsFeatured == true ? "checked" : "") />

                            <label class="form-check-label fw-bold" for="IsFeaturedSwitch">精選任務</label>
                        </div>
                    </div>
                </div>

                @* 隱藏不可編輯的系統時間欄位 *@
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="UpdatedAt" />

                <div class="mt-5 d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm">
                        <i class="bi bi-save me-2"></i>儲存修改
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-arrow-left me-2"></i>返回列表
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}