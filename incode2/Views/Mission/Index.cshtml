@model IEnumerable<incode2.Models.Mission>

@{
    ViewData["Title"] = "任務管理";
}

<div class="container-fluid py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">任務管理中心</h1>
        <a asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> 新增任務
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">所有任務列表</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="missionTable" width="100%" cellspacing="0">
                    <thead class="table-light text-center">
                        <tr>
                            <th>ID</th>
                            <th>任務資訊</th>
                            <th>類型</th>
                            <th>次數/目標</th>
                            <th>獎勵</th>
                            <th>難度</th>
                            <th>狀態</th>
                            <th style="min-width:160px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold">@item.MissionId</td>
                                <td>
                                    <div class="text-black font-weight-bold">@item.MissionName</div>
                                    <small class="text-muted text-truncate" style="max-width: 250px; display:inline-block;" title="@item.MissionDetail">
                                        @item.MissionDetail
                                    </small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary text-white">@item.Category</span>
                                </td>
                                <td class="text-center">
                                    <span class="font-weight-bold">@item.TargetCount</span>次/
                                    <small class="">@item.TargetType</small>
                                </td>
                                <td>
                                    <div class="text-primary small">
                                        <i class="fas fa-coins text-warning"></i> @item.RewardPoints
                                    </div>
                                    <div class="text-success small">
                                        <i class="fas fa-star text-success"></i> @item.RewardExp
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary">@item.Difficulty</span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-primary">啟用</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">停用</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        @* 新增的按鈕 *@
                                        <a asp-controller="MissionProgress" asp-action="Index" asp-route-MissionId="@item.MissionId" class="btn btn-sm btn-outline-secondary" title="查看參與者">
                                            <i class="fas fa-users"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MissionId" class="btn btn-sm btn-outline-primary" title="編輯">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.MissionId" class="btn btn-sm btn-outline-info" title="詳情">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MissionId" class="btn btn-sm btn-outline-danger" title="刪除">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#missionTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/zh-HANT.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": [7] } // 操作欄位不排序
                ],
                "pageLength": 10,
                "lengthMenu": [10, 25, 50]
            });
        });
    </script>
}