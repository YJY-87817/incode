@model IEnumerable<incode2.Models.EntrustMission>

@{
    ViewData["Title"] = "委託任務管理";
}

<div class="container-fluid py-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-tasks me-2"></i>委託任務管理</h6>
            <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus fa-sm text-white-50"></i> 新增任務
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="entrustTable" width="100%" cellspacing="0">
                    <thead class="table-light text-center">
                        <tr>
                            <th>ID</th>
                            <th>標題</th>
                            <th>獎勵點數</th>
                            <th>類別</th>
                            <th>期限</th>
                            <th>狀態</th>
                            <th>緊急度</th>
                            <th>最佳解答</th>
                            <th>發布者</th>
                            <th style="min-width:120px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@item.EntrustMissionId</td>
                                <td class="text-truncate" style="max-width: 200px;">
                                    <strong>@item.Title</strong>
                                </td>
                                <td class="text-center text-primary font-weight-bold">
                                    @item.RewardPoints
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-outline-secondary border text-secondary">@item.Category</span>
                                </td>
                                <td class="text-center">
                                    @if (!item.Deadline.HasValue)
                                    {
                                        <span class=" small">無期限</span>
                                    }
                                    else
                                    {
                                        <span class="small">@item.Deadline.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case "open":
                                            <span class="badge bg-success">開放中</span>
                                            break;
                                        case "completed":
                                            <span class="badge bg-primary">已完成</span>
                                            break;
                                        case "cancelled":
                                            <span class="badge bg-secondary">已取消</span>
                                            break;
                                        case "expired":
                                            <span class="badge bg-danger">已過期</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsUrgent ?? false)
                                    {
                                        <span class="badge bg-danger animate-pulse">
                                            <i class="fas fa-fire me-1"></i>緊急
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="small">一般</span>
                                    }
                                </td>
                                <td class="small">
                                    @(string.IsNullOrEmpty(item.BestUser?.Email) ? "-" : item.BestUser.Email.Split('@')[0])
                                </td>
                                <td class="small">
                                    @(string.IsNullOrEmpty(item.User?.Email) ? "-" : item.User.Email.Split('@')[0])
                                </td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.EntrustMissionId" class="btn btn-sm btn-outline-primary" title="編輯"><i class="fas fa-edit"></i></a>
                                        @* <a asp-action="Details" asp-route-id="@item.EntrustMissionId" class="btn btn-sm btn-outline-info" title="詳情"><i class="fas fa-eye"></i></a> *@
                                        @* <a asp-action="Delete" asp-route-id="@item.EntrustMissionId" class="btn btn-sm btn-outline-danger" title="刪除"><i class="fas fa-trash"></i></a> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#entrustTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/zh-HANT.json"
                },
                "order": [[0, "desc"]], // 預設用 ID 倒序排列（最新在上面）
                "columnDefs": [
                    { "orderable": false, "targets": [7, 8, 9] } // 姓名與操作欄位不開放排序
                ],
                "pageLength": 10,
                "lengthMenu": [10, 25, 50]
            });
        });
    </script>
}