@{
    ViewData["Title"] = "首頁";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h2>
                incode後臺管理
            </h2>
        </div>
        <!-- 會員Card  -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                目前會員數
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">20</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 文章Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                目前文章
                                <div class="h5 mb-0 font-weight-bold text-gray-800">20</div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- 會員發布任務數Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                會員發布任務數
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">100</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-exclamation fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 商品數Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                商品數量
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">18</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-brands fa-product-hunt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">

            <!-- 儀錶板 -->
            <div claas="col-xl-8">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">儀錶板</h6>
                    </div>
                    <div class="card-body">
                        <p>歡迎使用incode後臺管理系統！這裡是您的儀錶板，您可以在此查看網站的各項統計數據和重要資訊。</p>
                        <p>請使用左側的導航選單來管理會員、文章、任務和商品等功能。</p>
                    </div>
                </div>
            </div>

            <div claas="col-xl-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">最新消息</h6>
                    </div>
                    <div class="card-body">
                        <ul>
                            <li>系統更新：我們已經更新了後臺管理系統，新增了多項功能和改進。</li>
                            <li>會員活動：本月有多位會員參與了我們的活動，感謝大家的支持！</li>
                            <li>維護通知：系統將於下週進行例行維護，請提前做好準備。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts
{
    <script>
        // 可以在這裡添加自訂的JavaScript程式碼
    </script>
}