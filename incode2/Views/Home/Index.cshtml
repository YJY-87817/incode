@{
  ViewData["Title"] = "Home Page";
}

<div class="text-center">
  <div>@ViewBag.Fuen</div>
  <div>@ViewBag.content?.Body</div>
  <select class="form-select" asp-items="@ViewBag.user">
    <option>這個選項是另外加的option，會在最上面，asp-items=""ViewBag會在下面</option>
  </select>
  <div>圖片有加版本asp-append-version</div>
  <img src="~/img/corgi.png" asp-append-version />
</div>

@section Scripts
{
  <script>
    @Html.Raw(@ViewBag.JS)
  </script>
}