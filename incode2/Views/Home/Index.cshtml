@model incode2.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}


<div class="row">
    <div class="col-12">
        <h2>
            incode後臺管理
        </h2>
    </div>
    <!-- 會員Card  -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            目前會員數
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.displaycounts[0]</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 文章Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            目前文章
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.displaycounts[1]</div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 會員發布任務數Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            會員委託任務
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.displaycounts[2]</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-exclamation fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 商品數Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            待處理訂單數
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.displaycounts[3]</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-brands fa-product-hunt fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- 儀錶板 -->

    <!-- UserChart -->
    <div class="col-lg-7">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">會員數量</h6>
                <select id="yearSelector" class="form-control form-control-sm" style="width: auto;">
                    <option value="all">所有年份</option>
                </select>
            </div>
            <div class="card-body">
                <div class="chart-area">
                    <canvas id="UserChart"></canvas>
                </div>
                <hr>
                每月新增會員數量
            </div>
        </div>
    </div>

    <!-- ReportChart -->
    <div class="col-lg-5">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">前10發文者</h6>
            </div>
            <!-- Card Body -->
            <div class="card-body">
                <div class="chart-area">
                    <canvas id="reportChart"></canvas>
                </div>
                <hr>
                發文者
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script>
        var userDisplayData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.userdisplay));

        var userContentCount = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.userContentCounts));

        console.log(userContentCount);

        const reportChart = document.getElementById('reportChart');

        new Chart(reportChart, {
          type: 'bar',
          data: {
            labels: userContentCount.map(item => item.UserName),
            datasets: [{
              label: '發文數',
              data: userContentCount.map(item => item.ContentCount),
              backgroundColor: 'rgba(255, 0, 0, 0.5)',
              borderWidth: 1
            }]
          },
          options: {
            maintainAspectRatio: false,
            indexAxis: 'y', // 橫向長條圖
            scales: {
              x: {
                beginAtZero: true,
                // 1. 讓最大刻度比資料最大值多出一段空間 (例如 10% 或 固定數值)
                grace: '10%',
                ticks: {
                  // 2. 強制只顯示整數，不顯示小數點（如 1.5, 2.5）
                  precision: 0,
                  stepSize: 1 // 確保跳號是以 1 為單位
                }
              }
            },
            plugins: {
              // 如果你想在長條圖上方直接顯示數字，可以考慮加上這個提示
              legend: {
                display: true
              }
            }
          }
        });
    </script>
    <script src="~/js/chart-area.js"></script>
}