@model incode2.ViewModels.MemberEditViewModel

@{
    ViewData["Title"] = "修改會員資料";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 text-gray-800">修改會員資料</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> 返回列表
        </a>
    </div>

    <div class="row">
        <!-- 左側：基本資料設定 -->
        <div class="col-xl-5 col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user-edit me-2"></i>基本資料設定
                    </h6>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="UserId" />

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold text-gray-700">姓名</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold text-gray-700">Email (帳號)</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- 帳號狀態開關 -->
                        <div class="mb-4 p-3 bg-light border rounded">
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="activeSwitch" />
                                <label asp-for="IsActive" class="form-check-label fw-bold ms-2" for="activeSwitch">啟用帳號 (Is Active)</label>
                            </div>
                            <small class="text-muted mt-2 d-block">
                                <i class="fas fa-info-circle"></i> 若取消勾選，該使用者將被強制停權無法登入。
                            </small>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold text-gray-700">重設密碼 <span class="badge bg-secondary ms-1">選填</span></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="若不修改密碼，請保持空白" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fas fa-save me-1"></i> 儲存變更
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- 右側：登入紀錄 (異常偵測) -->
        <div class="col-xl-7 col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-left-info">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-shield-alt me-2"></i>最近登入紀錄 (異常偵測)
                    </h6>
                </div>
                <div class="card-body p-0 mt-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">登入時間</th>
                                    <th>IP 位置</th>
                                    <th>狀態評估</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentLoginLogs != null && Model.RecentLoginLogs.Any())
                                {
                                    @foreach (var log in Model.RecentLoginLogs)
                                    {
                                        <tr class="@(log.IsSuspicious ? "table-danger" : "")">
                                            <td class="ps-4">@log.LoginTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td class="font-monospace">@log.IpAddress</td>
                                            <td>
                                                @if (log.IsSuspicious)
                                                {
                                                    <span class="badge bg-danger px-2 py-1">
                                                        <i class="fas fa-exclamation-triangle"></i> 異常警告
                                                    </span>
                                                    <!-- ★ 微調了這裡的文案，使其符合您的邏輯 ★ -->
                                                    <small class="text-danger d-block mt-1 fw-bold">非慣用 IP</small>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success px-2 py-1">
                                                        <i class="fas fa-check-circle"></i> 正常
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-5">
                                            <i class="fas fa-history fa-2x mb-3 text-gray-300"></i>
                                            <p class="mb-0">該使用者尚無任何登入紀錄</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}