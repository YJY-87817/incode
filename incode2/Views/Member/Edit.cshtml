@model incode2.ViewModels.MemberEditViewModel

@{
    ViewBag.Title = "修改會員資料";
}

<div class="container mt-4">
    <h2>修改會員資料</h2>
    <hr />

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <strong>基本資料設定</strong>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                       <input type="hidden" asp-for="UserId" />  @* 知道現在是在改哪個人的資料 *@

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3 p-3 bg-light border rounded">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsActive" class="form-check-label fw-bold">啟用帳號 (Is Active)</label>
                            </div>
                            <small class="text-muted">若取消勾選，該使用者將無法登入</small>
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">重設密碼 (選填)</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="若不修改請留空" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">返回列表</a>
                            <button type="submit" class="btn btn-primary">儲存變更</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <strong>最近登入紀錄 (異常偵測)</strong>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>時間</th>
                                <th>IP 位置</th>
                                <th>狀態</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentLoginLogs != null && Model.RecentLoginLogs.Any())
                            {
                                @foreach (var log in Model.RecentLoginLogs)
                                {
                                    // 如果判定為異常，整行變紅
                                    <tr class="@(log.IsSuspicious ? "table-danger" : "")">
                                        <td>@log.LoginTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>@log.IpAddress</td>
                                        <td>
                                            @if (log.IsSuspicious)
                                            {
                                                <span class="badge bg-danger">異常警告</span>
                                                <small class="text-danger d-block">短時間/異地登入</small>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">正常</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted p-3">
                                        尚無登入紀錄
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}