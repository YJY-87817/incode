@model IEnumerable<incode2.ViewModels.MemberIndexViewModel>

@{
    ViewData["Title"] = "會員管理";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center">
            <h4 class="mb-0 font-weight-bold text-primary">會員資料管理</h4>
            <div class="ms-auto">
                <a asp-action="Create" class="btn btn-primary btn-icon-split">
                    <span class="icon text-white-50">
                        <i class="fas fa-user-plus"></i>
                    </span>
                    <span class="text">建立新帳號</span>
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="memberTable" class="table table-bordered table-striped table-hover align-middle" style="visibility: hidden; width:100%">
                    <thead class="table-light">
                        <tr class="text-center text-nowrap">
                            <th style="width:60px">ID</th>
                            <th>Email (帳號)</th>
                            <th>姓名</th>
                            <th>電話</th>
                            <th>生日</th>
                            <th>註冊時間</th>
                            <th style="width:80px">狀態</th>
                            <th style="width:150px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@item.UserId</td>

                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">@item.Email</span>
                                        @if (!string.IsNullOrEmpty(item.Address))
                                        {
                                            <small class="text-muted text-truncate" style="max-width: 150px;">@item.Address</small>
                                        }
                                    </div>
                                </td>

                                <td class="text-center">@item.Username</td>

                                <td class="text-center">
                                    @(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)
                                </td>

                                <td class="text-center">
                                    @(item.Birthday.HasValue? item.Birthday.Value.ToString("yyyy-MM-dd") : "-")
                                </td>

                                <!-- 註冊時間 (含排序資料) -->
                                <td class="text-center" data-order="@item.CreatedAt?.ToString("yyyyMMddHHmmss")">
                                    @item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")
                                </td>

                                <!-- 狀態 Badge -->
                                <td class="text-center" data-order="@(item.IsActive ? "1" : "0")">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success shadow-sm">啟用中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger shadow-sm">已停權</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-info text-white" title="編輯">
                                            <i class="fas fa-edit"></i> 修改
                                        </a>
                                        <!-- 這裡可以根據需求加上詳細資料按鈕 -->
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer text-muted small">
            資料更新時間：@DateTime.Now.ToString("yyyy-MM-dd HH:mm") | 共 @Model.Count() 位會員
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(function () {
            $('#memberTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.3.6/i18n/zh-HANT.json'
                },
                columnDefs: [
                    { targets: [7], orderable: false }
                ],
                initComplete: function() {
                    $('#memberTable').css('visibility', 'visible');
                }
            });
        });
    </script>
}