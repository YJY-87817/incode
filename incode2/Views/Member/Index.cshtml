@model IEnumerable<incode2.ViewModels.MemberIndexViewModel>

@{
    ViewData["Title"] = "會員管理";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center bg-white pt-3 pb-3">
            <h4 class="mb-0 font-weight-bold text-primary">
                <i class="fas fa-users me-2"></i>會員資料管理
            </h4>
            <div class="ms-auto">
                <a asp-action="Create" class="btn btn-primary btn-icon-split shadow-sm">
                    <span class="icon text-white-50">
                        <i class="fas fa-user-plus"></i>
                    </span>
                    <span class="text">建立新帳號</span>
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="memberTable" class="table table-bordered table-hover align-middle" style="visibility: hidden; width:100%">
                    <thead class="table-light">
                        <tr class="text-center text-nowrap">
                            <th style="width:60px">ID</th>
                            <th>帳號 (Email)</th>
                            <th>姓名</th>
                            <th>註冊時間</th>
                            <th>身分</th>
                            <th style="width:80px">狀態</th>
                            <th style="width:100px">異常狀態</th>
                            <th style="width:180px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center text-muted">@item.UserId</td>
                                <td class="fw-bold text-dark">@item.Email</td>
                                <td class="text-center">@item.Username</td>

                                <!-- 註冊時間 -->
                                <td class="text-center text-muted" data-order="@item.CreatedAt?.ToString("yyyyMMddHHmmss")">
                                    @item.CreatedAt?.ToString("yyyy-MM-dd")
                                </td>

                                <!-- 身分 -->
                                <td class="text-center">
                                    @if (item.RoleName == "管理員")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-user-shield"></i> 管理員</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">一般會員</span>
                                    }
                                </td>

                                <!-- 帳號狀態 -->
                                <td class="text-center" data-order="@(item.IsActive ? "1" : "0")">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success shadow-sm">啟用中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger shadow-sm">已停權</span>
                                    }
                                </td>

                                <!-- ★★★ 資安偵測 (異常 IP) ★★★ -->
                                <td class="text-center" data-order="@(item.HasSuspiciousLogin ? "1" : "0")">
                                    @if (item.HasSuspiciousLogin)
                                    {
                                        <span class="badge bg-danger shadow-sm px-2 py-1" title="近期有非慣用IP登入紀錄">
                                            <i class="fas fa-exclamation-triangle"></i> IP異常
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-success border px-2 py-1">
                                            <i class="fas fa-shield-alt"></i> 安全
                                        </span>
                                    }
                                </td>

                                <!-- 操作 -->
                                <td class="text-center">
                                    <div class="btn-group shadow-sm" role="group">
                                        <!-- 詳細資料按鈕 (觸發 Modal)，把資料藏在 data-* 屬性裡 -->
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-detail"
                                                data-id="@item.UserId"
                                                data-name="@item.Username"
                                                data-email="@item.Email"
                                                data-phone="@item.Phone"
                                                data-birthday="@(item.Birthday?.ToString("yyyy-MM-dd"))"
                                                data-address="@item.Address"
                                                data-created="@item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")"
                                                data-bs-toggle="modal" data-bs-target="#detailModal">
                                            <i class="fas fa-search"></i> 詳細
                                        </button>

                                        <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-info text-white" title="編輯與紀錄">
                                            <i class="fas fa-edit"></i> 編輯
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted small bg-white">
            資料更新時間：@DateTime.Now.ToString("yyyy-MM-dd HH:mm") | 共 @Model.Count() 位會員
        </div>
    </div>
</div>

<!-- ★★★ 會員詳細資料彈出視窗 (Modal) ★★★ -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="detailModalLabel"><i class="fas fa-id-card me-2"></i>會員詳細資料</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <table class="table table-borderless table-sm mb-0">
                    <tbody>
                        <tr>
                            <th style="width: 100px;" class="text-muted">會員 ID：</th>
                            <td id="modal-id" class="fw-bold"></td>
                        </tr>
                        <tr>
                            <th class="text-muted">帳號：</th>
                            <td id="modal-email"></td>
                        </tr>
                        <tr>
                            <th class="text-muted">姓名：</th>
                            <td id="modal-name"></td>
                        </tr>
                        <tr>
                            <td colspan="2"><hr class="my-1"></td>
                        </tr>
                        <tr>
                            <th class="text-muted"><i class="fas fa-phone me-1"></i> 電話：</th>
                            <td id="modal-phone"></td>
                        </tr>
                        <tr>
                            <th class="text-muted"><i class="fas fa-birthday-cake me-1"></i> 生日：</th>
                            <td id="modal-birthday"></td>
                        </tr>
                        <tr>
                            <th class="text-muted"><i class="fas fa-map-marker-alt me-1"></i> 地址：</th>
                            <td id="modal-address"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer bg-light">
                <span class="text-muted small me-auto">註冊於：<span id="modal-created"></span></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(function () {
            // 1. 初始化 DataTable
            $('#memberTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.3.6/i18n/zh-HANT.json'
                },
                columnDefs: [
                    { targets: [6, 7], orderable: false } // 資安狀態與操作按鈕不排序
                ],
                initComplete: function() {
                    $('#memberTable').css('visibility', 'visible');
                }
            });

            // 2. 處理點擊「詳細」按鈕時，將資料填入 Modal
            $('.btn-detail').on('click', function () {
                var btn = $(this);
                // 取出按鈕上綁定的資料
                $('#modal-id').text(btn.data('id'));
                $('#modal-email').text(btn.data('email'));
                $('#modal-name').text(btn.data('name') || '-');
                $('#modal-phone').text(btn.data('phone') || '未提供');
                $('#modal-birthday').text(btn.data('birthday') || '未提供');
                $('#modal-address').text(btn.data('address') || '未提供');
                $('#modal-created').text(btn.data('created'));
            });
        });
    </script>
}