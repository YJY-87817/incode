@model incode2.Models.CommunityViewModel

@{
    ViewData["Title"] = "會員資料";
}

<h1>追蹤名單</h1>
<div>
    
    <hr />
    <dl class="row">
       
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Username)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Username)
        </dd>
        <table class="table">
            <thead>
                <tr>                    
                    <th>粉絲名稱</th>
                    <th>目前粉絲人數</th>

                    @* <th>追蹤</th> *@
                    
                </tr>
            </thead>
            <tbody>
                
                @if (Model.SocialLinks != null && Model.SocialLinks.Any())
                {
                    foreach (var link in Model.SocialLinks)
                    {
                        <tr>                          
                            <td>@link.Username</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2">目前沒有追蹤任何人。</td>
                    </tr>
                }
                <td>@Model.SocialLinks?.Count()</td>
            </tbody>
        </table>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.UserId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>