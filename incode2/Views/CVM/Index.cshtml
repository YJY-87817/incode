@model IEnumerable<incode2.Models.CommunityViewModel>

<h1>社群相關資料</h1>

<div>
    <table class="table">
        <thead>
        <tr>           
            <th>
                @Html.DisplayNameFor(model => model.Username)
            </th>           
            <th>
                @Html.DisplayNameFor(model => model.FollowerId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FolloweeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Experience)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rank)
            </th>
                <th></th>
        </tr>
        </thead>
        @foreach (var item in Model)
        {
            <tr>            
            <td>
            @Html.DisplayFor(modelItem => item.Username)
            </td>            
            <td>
            @Html.DisplayFor(modelItem => item.FollowerId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FolloweeId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Experience)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rank)
            </td>    
            <td>
                    <a asp-action="Edit" asp-route-id="@item.UserId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.UserId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.UserId">Delete</a>
            </td>
        </tr>
        }
        </table>
</div>
        
