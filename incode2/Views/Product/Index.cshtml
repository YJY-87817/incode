@model IEnumerable<incode2.Models.Product>

@{
    ViewData["Title"] = "商品管理";
}
<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center">
            <h4 class="mb-0">商品管理</h4>
            <div class="ms-auto">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fa fa-plus me-2" aria-hidden="true"></i> 新增商品
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="mb-3 row">
                <div class="col-md-4">
                    <input id="productSearch" class="form-control" placeholder="搜尋商品名稱或類別..." />
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th style="width:80px">商品ID</th>
                            <th>商品名稱</th>
                            <th style="width:120px">類別</th>
                            <th style="width:120px">照片</th>
                            <th style="width:100px">有實體</th>
                            <th style="width:90px">點數</th>
                            <th style="width:90px">庫存</th>
                            <th style="width:140px">加入時間</th>
                            <th style="width:140px">最後修改時間</th>
                            <th style="width:100px">販售中</th>
                            <th style="width:120px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@Html.DisplayFor(modelItem => item.ProductId)</td>
                                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                <td class="text-center">@Html.DisplayFor(modelItem => item.Type)</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.ImageName))
                                    {
                                        <img src="~/img/product/@item.ImageName" alt="@item.Name" class="img-fluid rounded" style="max-width:80px; height:auto;" />
                                    }
                                    else
                                    {
                                        <img src="~/img/product/noimage.png" alt="暫無照片" class="img-fluid rounded" style="max-width:80px; height:auto;" />
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsPhysical)
                                    {
                                        <span class="badge bg-primary">實體</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">虛寶</span>
                                    }
                                </td>
                                <td class="text-center">@Html.DisplayFor(modelItem => item.Point)</td>
                                <td class="text-center">@Html.DisplayFor(modelItem => item.Stock)</td>
                                <td class="text-center">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-center">@item.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-center">
                                    @if (item.OnSale)
                                    {
                                        <span class="badge bg-success">販售中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">未販售</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-sm btn-primary" asp-controller="Product" asp-action="Edit" asp-route-ProductId="@item.ProductId">
                                            詳細/修改
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer text-muted">
            共 @Model.Count() 項商品
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        // 簡單前端搜尋（客戶端 filter）
        document.getElementById('productSearch')?.addEventListener('input', function (e) {
            var q = e.target.value.toLowerCase();
            document.querySelectorAll('table tbody tr').forEach(function (tr) {
                var name = (tr.children[1]?.innerText || '').toLowerCase();
                var type = (tr.children[2]?.innerText || '').toLowerCase();
                tr.style.display = (name.indexOf(q) !== -1 || type.indexOf(q) !== -1) ? '' : 'none';
            });
        });
    </script>
}