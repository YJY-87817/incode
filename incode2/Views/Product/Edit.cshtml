@model incode2.Models.Product

@{
    ViewData["Title"] = "商品管理";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning py-3">
                    <h4 class="mb-0 fs-5 fw-bold text-dark"><i class="bi bi-pencil-square me-2"></i>商品修改</h4>
                </div>

                <div class="card-body p-4">
                    <form id="editForm" asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" asp-for="ImageName" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row">
                            <div class="col-md-7">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label fw-bold">商品名稱 <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="form-control" required>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label fw-bold">商品描述</label>
                                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Type" class="form-label fw-bold">商品類別 <span class="text-danger">*</span></label>
                                        <select asp-for="Type" class="form-select border-warning-subtle" required>
                                            <option value="">-- 請選擇 --</option>
                                            <option value="兌換票券">兌換票券</option>
                                            <option value="電影周邊">電影周邊</option>
                                            <option value="造型">造型</option>
                                            <option value="其他">其他</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Series" class="form-label fw-bold">系列 <span class="text-danger">*</span></label>
                                        <input asp-for="Series" class="form-control" required>
                                    </div>

                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="Point" class="form-label fw-bold text-danger">所需點數 <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text">P</span>
                                            <input asp-for="Point" type="number" class="form-control" min="0" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Stock" class="form-label fw-bold text-success">庫存數量 <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text">件</span>
                                            <input asp-for="Stock" type="number" class="form-control" min="0" required>
                                        </div>
                                    </div>
                                </div>

                                <div class="p-3 bg-light rounded mb-4">
                                    <div class="row small text-muted">
                                        <div class="col-6">
                                            <label class="fw-bold mb-1">新增時間</label>
                                            <div>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                                        </div>
                                        <div class="col-6">
                                            <label class="fw-bold mb-1">最後修改</label>
                                            <div>@Model.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-5 border-start text-center">
                                <label class="form-label fw-bold text-muted mb-3">圖片預覽</label>
                                <div class="preview-wrapper p-2 border rounded bg-white shadow-sm mx-auto" style="width: 250px; height: 250px;">
                                    @if (!string.IsNullOrEmpty(Model.ImageName))
                                    {
                                        <img src="~/img/product/@Model.ImageName" id="imagePreview" class="img-fluid rounded" style="max-height: 230px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <img id="imagePreview" class="img-fluid rounded d-none" style="max-height: 230px; object-fit: contain;" />
                                        <div id="noImageText" class="py-5 text-muted"><i class="bi bi-image display-4"></i><p>暫無圖片</p></div>
                                    }
                                </div>
                                <div class=" mb-3">
                                    <label class="form-label fw-bold text-primary">更換圖片</label>
                                    <input name="imageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(this)" />
                                    <small class="text-muted">若不更換請留空</small>
                                </div>

                                <div class="mt-4 px-4 text-start">
                                    <div class="form-check form-switch mb-2">
                                        <input asp-for="IsPhysical" class="form-check-input" type="checkbox">
                                        <label class="form-check-label fw-bold" asp-for="IsPhysical">實體商品</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input asp-for="OnSale" class="form-check-input" type="checkbox">
                                        <label asp-for="OnSale" class="form-check-label fw-bold">販售中</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- 驗證提示訊息 -->
                        <div id="validationAlert" class="alert alert-danger d-none mb-4" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <strong>請檢查以下必填欄位：</strong>
                            <ul id="errorList" class="mb-0 mt-2"></ul>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-warning px-5 fw-bold shadow-sm text-dark" onclick="validateForm(event)">
                                <i class="bi bi-check-circle me-1"></i> 儲存修改
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">取消</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('imagePreview');
                    const noImageText = document.getElementById('noImageText');

                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    if (noImageText) noImageText.classList.add('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function validateForm(event) {
            const form = document.getElementById('editForm');
            const validationAlert = document.getElementById('validationAlert');
            const errorList = document.getElementById('errorList');
            const errors = [];

            // 清空錯誤列表
            errorList.innerHTML = '';

            // 驗證必填欄位
            const name = document.querySelector('input[name="Name"]');
            if (!name.value.trim()) {
                errors.push('商品名稱');
            }

            const type = document.querySelector('select[name="Type"]');
            if (!type.value) {
                errors.push('商品類別');
            }

            const series = document.querySelector('input[name="Series"]');
            if (!series.value.trim()) {
                errors.push('系列');
            }

            const point = document.querySelector('input[name="Point"]');
            if (!point.value) {
                errors.push('所需點數');
            }

            const stock = document.querySelector('input[name="Stock"]');
            if (!stock.value) {
                errors.push('庫存數量');
            }

            // 如果有錯誤，顯示提示並阻止提交
            if (errors.length > 0) {
                event.preventDefault();
                errors.forEach(error => {
                    errorList.innerHTML += `<li>${error}</li>`;
                });
                validationAlert.classList.remove('d-none');
                // 滾動到錯誤訊息位置
                validationAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                // 沒有錯誤，隱藏提示訊息
                validationAlert.classList.add('d-none');
                // 允許表單提交
                form.submit();
            }
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
