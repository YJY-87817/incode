@model incode2.Models.Product

@{
    ViewData["Title"] = "新增商品";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-box-seam me-2"></i>管理後台 - 新增商品</h4>
                </div>

                <div class="card-body p-4">
                    <form id="createForm" asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-7">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label fw-bold">商品名稱 <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="form-control" placeholder="例如：限量電影海報" required>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label fw-bold">商品描述</label>
                                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="請描述商品的特色..."></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Type" class="form-label fw-bold">商品類別 <span class="text-danger">*</span></label>
                                        <select asp-for="Type" class="form-select border-primary-subtle" required>
                                            <option value="" selected disabled>請選擇...</option>
                                            <option value="兌換票券">兌換票券</option>
                                            <option value="電影周邊">電影周邊</option>
                                            <option value="造型">造型</option>
                                            <option value="其他">其他</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Series" class="form-label fw-bold">系列 <span class="text-danger">*</span></label>
                                        <input asp-for="Series" class="form-control" placeholder="例如：星戰" required>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Point" class="form-label fw-bold">所需點數 <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-primary"><i class="bi bi-coin"></i></span>
                                            <input asp-for="Point" type="number" class="form-control" min="0" value="0" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Stock" class="form-label fw-bold">庫存數量 <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light"><i class="bi bi-archive"></i></span>
                                            <input asp-for="Stock" type="number" class="form-control" min="0" value="0" required>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-light border-0 mb-4">
                                    <div class="card-body py-2 d-flex gap-4">
                                        <div class="form-check form-switch">
                                            <input asp-for="IsPhysical" class="form-check-input" type="checkbox">
                                            <label class="form-check-label fw-bold" asp-for="IsPhysical">實體商品</label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input asp-for="OnSale" class="form-check-input" type="checkbox" checked>
                                            <label asp-for="OnSale" class="form-check-label fw-bold">販售中</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-5 border-start d-flex flex-column align-items-center justify-content-start pt-2">
                                <label class="form-label fw-bold text-muted mb-3">圖片預覽</label>
                                <div id="previewContainer" class="d-flex align-items-center justify-content-center border rounded bg-light" style="width: 100%; min-height: 250px; overflow: hidden;">
                                    <i id="previewIcon" class="bi bi-image text-muted display-1"></i>
                                    <img id="imagePreview" src="#" alt="預覽圖" class="img-fluid d-none" />
                                </div>
                                <p class="small text-muted mt-2">建議尺寸: 800x800 px</p>
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-primary">上傳圖片</label>
                                    <input name="imageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(this)" />
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- 驗證提示訊息 -->
                        <div id="validationAlert" class="alert alert-danger d-none mb-4" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <strong>請檢查以下必填欄位：</strong>
                            <ul id="errorList" class="mb-0 mt-2"></ul>
                        </div>

                        <div class="d-flex gap-3 mt-2">
                            <button id="BtnCreate" type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm" onclick="validateForm(event)">
                                <i class="bi bi-cloud-arrow-up me-1"></i> 立即上架商品
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 py-2">返回清單</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script>
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const icon = document.getElementById('previewIcon');

            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none'); // 顯示圖片
                    icon.classList.add('d-none');      // 隱藏圖示
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.classList.add('d-none');
                icon.classList.remove('d-none');
            }
        }

        function validateForm(event) {
            const form = document.getElementById('createForm');
            const validationAlert = document.getElementById('validationAlert');
            const errorList = document.getElementById('errorList');
            const errors = [];

            // 清空錯誤列表
            errorList.innerHTML = '';

            // 驗證必填欄位
            const name = document.querySelector('input[name="Name"]');
            if (!name.value.trim()) {
                errors.push('商品名稱');
            }

            const type = document.querySelector('select[name="Type"]');
            if (!type.value) {
                errors.push('商品類別');
            }

            const series = document.querySelector('input[name="Series"]');
            if (!series.value.trim()) {
                errors.push('系列');
            }

            const point = document.querySelector('input[name="Point"]');
            if (!point.value || point.value == 0) {
                errors.push('所需點數');
            }

            const stock = document.querySelector('input[name="Stock"]');
            if (!stock.value || stock.value == 0) {
                errors.push('庫存數量');
            }

            // 如果有錯誤，顯示提示並阻止提交
            if (errors.length > 0) {
                event.preventDefault();
                errors.forEach(error => {
                    errorList.innerHTML += `<li>${error}</li>`;
                });
                validationAlert.classList.remove('d-none');
                // 滾動到錯誤訊息位置
                validationAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                // 沒有錯誤，隱藏提示訊息
                validationAlert.classList.add('d-none');
                // 允許表單提交
                form.submit();
            }
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
