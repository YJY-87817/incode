@model incode2.ViewModels.OrderViewModel

@{
    ViewData["Title"] = "訂單管理";
}
<h2>新增訂單</h2>

<div class="col-8">
    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="UserId" class="form-label fw-bold">會員ID:</label>
                <input asp-for="UserId" class="form-control" required>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="TotalPoint" class="form-label fw-bold">總點數:</label>
                <input asp-for="TotalPoint" type="number" class="form-control" min="0">
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Status" class="form-label fw-bold">訂單狀態:</label>
                <select asp-for="Status" class="form-select">
                    <option value="未完成" selected>未完成</option>
                    <option value="完成">完成</option>
                    <option value="取消">取消</option>
                    <option value="其他">其他</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Remark" class="form-label fw-bold">備註:</label>
            <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-grid gap-2 mt-4">
            <button id="BtnCreate" type="submit" class="btn btn-primary">新增訂單</button>
        </div>

        <table class="table table-bordered mt-4" width="100%">
            <thead>
                <tr class="text-center">
                    <th>商品</th>
                    <th>數量</th>
                    <th>下單時點數</th>
                    <th>總點數</th>
                    <th>需寄送</th>
                    <th>刪除</th>
                </tr>
            </thead>
            <tbody id="shoppingList">
                <tr class="text-center align-middle">
                    <td>
                        <select id="select[0]" class="form-select" name="orderdetails[0].ProductId" onchange="PointChange(this)" required>
                            <option value="">--請選擇商品--</option>
                            @if (ViewBag.Products != null)
                            {
                                foreach (var p in (List<Product>)ViewBag.Products)
                                {
                                    <option value="@p.ProductId" data-point="@p.Point">@p.Name （@p.Point 點） 庫存:@p.Stock</option>
                                }
                            }
                        </select>
                    </td>
                    <td><input type="number" class="form-control" name="orderdetails[0].Quantity" min="1" value="1" onchange="quantity(this)" /></td>
                    @* 點數 *@
                    <td><input type="number" class="form-control" name="orderdetails[0].UnitPointAtPurchase" min="1" value="1" readonly /></td> 
                    @* 總點數 *@
                    <td><input type="number" class="form-control countpoint" min="1" value="1" readonly /></td>
                    <td>
                        <input type="hidden" name="orderdetails[0].RequiresShipping" value="false" />
                        <input type="checkbox" class="form-check-input" name="orderdetails[0].RequiresShipping" value="true" />
                    </td>
                    <td><button type="button" class="btn btn-danger remove-btn" onclick="removeRow(this)">刪除</button></td>
                </tr>
            </tbody>
        </table>
        <div class="d-grid gap-2 mt-2">
            <button id="BtnNewProduct" type="button" class="btn btn-primary" onclick="newOrderList()">加入商品</button>
        </div>
    </form>
</div>


@section Scripts
{<script>
    function newOrderList() {
    let index = $("#shoppingList tr").length; // 取得目前列數作為索引
    let newRow = 
        `<tr class="text-center align-middle">
            <td>
                <select id="select[${index}]" class="form-select" name="orderdetails[${index}].ProductId" onchange="PointChange(this)" required>
                    <option value="">--請選擇商品--</option>
                    @if (ViewBag.Products != null)
                    {
                        foreach (var p in (List<Product>)ViewBag.Products)
                        {
                            <option value="@p.ProductId" data-point="@p.Point">@p.Name （@p.Point 點） 庫存:@p.Stock</option>
                        }
                    }
                 </select>
            </td>
            <td><input type="number" class="form-control" name="orderdetails[${index}].Quantity" min="1" value="1" onchange="quantity(this)" /></td>
            @* 點數 *@
            <td><input type="number" class="form-control" name="orderdetails[${index}].UnitPointAtPurchase" min="1" value="1" readonly /></td>
            @* 總點數 *@
                 <td><input type="number" class="form-control countpoint" min="1" value="1" readonly/></td>
            <td>
                <input type="hidden" name="orderdetails[0].RequiresShipping" value="false" />
                <input type="checkbox" class="form-check-input" name="orderdetails[${index}].RequiresShipping" value="true" />
            </td>
            <td><button type="button" class="btn btn-danger remove-btn" onclick="removeRow(this)">刪除</button></td>
        </tr>`
    $("#shoppingList").append(newRow);
    }

    function removeRow(btn) {
    $(btn).closest('tr').remove();
    reIndexTable(); // 重新排序索引以確保連續性
    }

    function reIndexTable() {
    $("#shoppingList tr").each(function(i) {
        $(this).find("[name]").each(function() {
            var name = $(this).attr("name");
            // 將 orderdetails[x].Prop 替換為 orderdetails[i].Prop
            $(this).attr("name", name.replace(/\[\d+\]/, "[" + i + "]"));
        });
    });
    }

    function PointChange(select) {
         // 取得選中 option 的 data-point 屬性
         var point = $(select).find(':selected').data('point');
         // 找到同一列的單價輸入框並賦值
         $(select).closest('tr').find('input[name*="UnitPointAtPurchase"]').val(point);
         $(select).closest('tr').find('input[class*="countpoint"]').val(point);
    }

    function quantity(count) {
        var p = $(count).val();
        console.log(p);
    }
</script>
}