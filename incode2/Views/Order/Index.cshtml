@model IEnumerable<incode2.Models.Orders>

@{
    ViewData["Title"] = "訂單與寄送管理";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">訂單與寄送管理</h4>
        </div>

        <div class="card-body">
            <partial name="_TempDataAlert" />
            <!-- Nav tabs -->
            <ul class="nav nav-pills" id="orderShippedTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="order-tab" data-bs-toggle="tab" data-bs-target="#order" type="button" role="tab" aria-controls="order" aria-selected="true">
                        <i class="fa fa-shopping-cart me-2"></i>訂單管理
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="shipped-tab" data-bs-toggle="tab" data-bs-target="#shipped" type="button" role="tab" aria-controls="shipped" aria-selected="false">
                        <i class="fa fa-shipping-fast me-2"></i>寄送管理
                    </button>
                </li>
            </ul>

            <!-- Tab panes -->
            <div class="tab-content mt-3" id="orderShippedTabContent">
                <!-- 訂單管理標籤 -->
                <div class="tab-pane fade show active" id="order" role="tabpanel" aria-labelledby="order-tab">
                    <div class="d-flex justify-content-end mb-3">
                        <a asp-action="Create" class="btn btn-success">
                            <i class="fa fa-plus me-2" aria-hidden="true"></i> 新增訂單
                        </a>
                    </div>
                    
                    <div class="table-responsive">
                        <table id="orderTable" class="table table-bordered table-striped table-hover align-middle" style="visibility: hidden;">
                            <thead class="table-light">
                                <tr class="text-center">
                                    <th style="width:90px">訂單ID</th>
                                    <th style="width:110px">會員ID</th>
                                    <th style="width:110px">總點數</th>
                                    <th style="width:170px">訂單時間</th>
                                    <th>備註</th>
                                    <th style="width:120px">狀態</th>
                                    <th style="width:170px">取消時間</th>
                                    <th style="width:120px">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@Html.DisplayFor(modelItem => item.OrderId)</td>
                                        <td class="text-center">@Html.DisplayFor(modelItem => item.UserId)</td>
                                        <td class="text-center">@Html.DisplayFor(modelItem => item.TotalPoint)</td>
                                        <td class="text-center" data-order="@item.OrderDate.ToString("yyyy-MM-dd HH:mm:ss")">@item.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@Html.DisplayFor(modelItem => item.Remark)</td>
                                        <td class="text-center" data-order="@(item.Status ?? "")">
                                            @if (!string.IsNullOrEmpty(item.Status))
                                            {
                                                <span class="badge @(item.Status == "已完成" ? "bg-success" : item.Status == "已取消" ? "bg-danger" : item.Status == "待處理" ? "bg-warning" : "bg-secondary")">
                                                    @item.Status
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center" data-order="@(item.CanceledAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")">@(item.CanceledAt?.ToString("yyyy-MM-dd HH:mm") ?? "")</td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a class="btn btn-sm btn-primary" asp-controller="Order" asp-action="Edit" asp-route-OrderId="@item.OrderId">查看修改</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="text-muted mt-3">
                        共 @Model.Count() 筆訂單
                    </div>
                </div>

                <!-- 寄送管理標籤 -->
                <div class="tab-pane fade" id="shipped" role="tabpanel" aria-labelledby="shipped-tab">
                    <div class="d-flex justify-content-end mb-3">
                        <a asp-controller="Shipped" asp-action="Create" class="btn btn-success">
                            <i class="fa fa-plus me-2" aria-hidden="true"></i> 新增寄送資料
                        </a>
                    </div>
                    
                    <div class="table-responsive">
                        <table id="shippedTable" class="table table-bordered table-striped table-hover align-middle" style="visibility: hidden;">
                            <thead class="table-light">
                                <tr class="text-center">
                                    <th style="width:60px">寄送ID</th>
                                    <th style="width:60px">訂單ID</th>
                                    <th style="width:60px">狀態</th>
                                    <th style="width:80px">姓名</th>
                                    <th style="min-width:250px">地址</th>
                                    <th style="width:110px">電話</th>
                                    <th style="width:140px">寄送日期</th>
                                    <th style="width:140px">送達日期</th>
                                    <th style="width:60px">失敗</th>
                                    <th style="min-width:100px">說明</th>
                                    <th style="width:100px">完成</th>
                                    <th style="width:60px">查看</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- 寄送資料將透過 AJAX 載入 -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(function () {
            // 初始化訂單表格
            $('#orderTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.3.6/i18n/zh-HANT.json'
                },
                columnDefs: [
                    { targets: [7], orderable: false }
                ],
                initComplete: function() {
                    $('#orderTable').css('visibility', 'visible');
                }
            });

            var shippedTable = null;
            var shippedDataLoaded = false;

            // 當切換到寄送管理標籤時載入資料
            $('#shipped-tab').on('shown.bs.tab', function (e) {
                if (!shippedDataLoaded) {
                    $.ajax({
                        url: '@Url.Action("GetShippedData", "Order")',
                        type: 'GET',
                        success: function(data) {
                            var tbody = $('#shippedTable tbody');
                            tbody.empty();
                            
                            data.forEach(function(item) {
                                var statusBadge = '';
                                if (item.orderStatus) {
                                    var badgeClass = 'bg-secondary';
                                    if (item.orderStatus === '已完成') badgeClass = 'bg-success';
                                    else if (item.orderStatus === '已取消') badgeClass = 'bg-danger';
                                    else if (item.orderStatus === '待處理') badgeClass = 'bg-warning';
                                    statusBadge = '<span class="badge ' + badgeClass + '">' + item.orderStatus + '</span>';
                                }

                                var failedBadge = item.isFailed 
                                    ? '<span class="badge bg-danger">是</span>' 
                                    : '<span class="badge bg-success">否</span>';

                                var completedBadge = item.isCompleted 
                                    ? '<span class="badge bg-success">完成</span>' 
                                    : '<span class="badge bg-secondary">未完成</span>';

                                var row = '<tr>' +
                                    '<td class="text-center">' + item.shippedDetailId + '</td>' +
                                    '<td class="text-center">' + item.orderId + '</td>' +
                                    '<td class="text-center" data-order="' + (item.orderStatus || '') + '">' + statusBadge + '</td>' +
                                    '<td>' + (item.recipientName || '') + '</td>' +
                                    '<td>' + (item.recipientAddress || '') + '</td>' +
                                    '<td class="text-center">' + (item.recipientPhone || '') + '</td>' +
                                    '<td class="text-center" data-order="' + (item.shippedDate || '') + '">' + (item.shippedDateFormatted || '') + '</td>' +
                                    '<td class="text-center" data-order="' + (item.arrivalDate || '') + '">' + (item.arrivalDateFormatted || '') + '</td>' +
                                    '<td class="text-center" data-order="' + (item.isFailed ? '1' : '0') + '">' + failedBadge + '</td>' +
                                    '<td>' + (item.remark || '') + '</td>' +
                                    '<td class="text-center" data-order="' + (item.isCompleted ? '1' : '0') + '">' + completedBadge + '</td>' +
                                    '<td class="text-center">' +
                                        '<div class="btn-group" role="group">' +
                                            '<a class="btn btn-sm btn-primary" href="/Shipped/Edit/' + item.shippedDetailId + '">修改</a>' +
                                            '<a class="btn btn-sm btn-danger" href="/Shipped/Delete/' + item.shippedDetailId + '">刪除</a>' +
                                        '</div>' +
                                    '</td>' +
                                '</tr>';
                                tbody.append(row);
                            });

                            // 初始化 DataTable
                            if (shippedTable) {
                                shippedTable.destroy();
                            }
                            shippedTable = $('#shippedTable').DataTable({
                                language: {
                                    processing: "處理中...",
                                    loadingRecords: "載入中...",
                                    lengthMenu: "顯示 _MENU_ 筆資料",
                                    zeroRecords: "沒有符合的資料",
                                    info: "顯示第 _START_ 至 _END_ 筆資料，共 _TOTAL_ 筆",
                                    infoEmpty: "顯示第 0 至 0 筆資料，共 0 筆",
                                    infoFiltered: "(從 _MAX_ 筆資料中過濾)",
                                    search: "搜尋:",
                                    paginate: {
                                        first: "第一頁",
                                        previous: "上一頁",
                                        next: "下一頁",
                                        last: "最後一頁"
                                    }
                                },
                                order: [[0, 'desc']],
                                pageLength: 10,
                                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "全部"]],
                                columnDefs: [
                                    { orderable: false, targets: [11] }
                                ],
                                responsive: true,
                                autoWidth: false
                            });
                            
                            $('#shippedTable').css('visibility', 'visible');
                            shippedDataLoaded = true;
                        },
                        error: function() {
                            alert('載入寄送資料失敗');
                        }
                    });
                }
            });
        });
    </script>
}