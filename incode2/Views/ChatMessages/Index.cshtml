@model IEnumerable<incode2.Models.ChatMessage>

@{
    ViewBag.Title = "後台訊息管理";
}

<h2>後台訊息管理</h2>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                對話群組 (Session)
            </th>
            <th>
                角色 (Role)
            </th>
            <th>
                訊息內容 (Body)
            </th>
            <th>
                發送時間 (Created At)
            </th>
            <th>管理功能</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @(item.Session != null ? item.Session.Title : "Session #" + item.SessionId)
                </td>
                <td>
                    @if (item.Role == "user")
                    {
                        <span class="badge bg-primary">使用者</span>
                    }
                    else if (item.Role == "assistant" || item.Role == "model")
                    {
                        <span class="badge bg-success">AI 機器人</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Role</span>
                    }
                </td>
                <td title="@item.Body">
                    @if (!string.IsNullOrEmpty(item.Body) && item.Body.Length > 50)
                    {
                        @item.Body.Substring(0, 50) <text>...</text>
                    }
                    else
                    {
                        @item.Body
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @Html.ActionLink("刪除", "Delete", new { id = item.ChatMessageId },
                    new { @class = "btn btn-danger btn-sm", onclick = "return confirm('確定要刪除這則訊息嗎？');" })
            </td>
        </tr>
                }
    </tbody>
</table>