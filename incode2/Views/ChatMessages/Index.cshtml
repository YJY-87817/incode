@model incode2.ViewModels.ChatIndexViewModel

@{
    ViewData["Title"] = "客服訊息管理";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentSessionId = Model.CurrentChatSessionId ?? 0;

    // 預設為 AI 模式 (false)，實際狀態由 SignalR 連線後動態控制
    bool isHumanMode = false;

    var targetUserName = Model.TargetUser?.Username ?? "訪客";

    var targetUserAvatar = !string.IsNullOrEmpty(Model.TargetUser?.ImageUrl)
        ? Model.TargetUser.ImageUrl
        : "https://duk.tw/ggJM6i.jpg";
}

@section Styles {
    <style>
        /* --- 基礎佈局 --- */
        .chat-container {
            height: 75vh;
            overflow: hidden;
        }

        .chat-col {
            height: 100%;
        }

        .chat-card {
            height: 100%;
            display: flex;
            flex-direction: column;
            border: 1px solid #e3e6f0;
            overflow: hidden;
        }

        /* 強制隱藏對話框內的所有頭像 */
        .answer .avatar-chat-img {
            display: none !important;
        }

        /* --- 左側列表樣式 --- */
        .user-list-area {
            flex: 1;
            overflow-y: auto;
            background-color: #fff;
        }

        .session-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            color: inherit;
            text-decoration: none !important;
            transition: background-color 0.2s;
        }

            .session-item:hover {
                background-color: #f8f9fc;
            }

            .session-item.active {
                background-color: #e6f0ff;
                border-left: 4px solid #4e73df;
            }

        .avatar-list-img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
        }

        .chat-item-content {
            flex: 1;
            margin-left: 10px;
            overflow: hidden;
        }

        .chat-item-name {
            font-weight: bold;
            color: #5a5c69;
        }

        .chat-item-preview {
            font-size: 0.85rem;
            color: #858796;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* --- 右側聊天區域樣式 --- */
        .chat-scroll-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background-color: #f8f9fc;
        }

        /* --- 氣泡樣式 --- */
        .answer {
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            max-width: 70%;
            width: fit-content;
        }

        .answer .text {
            width: fit-content;
            max-width: 70%;
            padding: 6px 10px;
            border-radius: 1rem;
            font-size: 1rem;
            line-height: 1.5;
            position: relative;
            word-wrap: break-word;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            /* 左側 (User) */
            .answer.left {
                align-self: flex-start;
            }

                .answer.left .text {
                    background: #fff;
                    color: #5a5c69;
                    border-bottom-left-radius: 0;
                    margin-left: 10px;
                }

                    .answer.left .text::before {
                        content: '';
                        display: block;
                        position: absolute;
                        bottom: 0;
                        left: -10px;
                        border-top: 10px solid transparent;
                        border-right: 10px solid #fff;
                    }

            /* 右側 (Admin/AI) */
            .answer.right {
                align-self: flex-end;
                margin-left: auto;
            }

                .answer.right .text {
                    background: #4e73df;
                    color: #fff;
                    border-bottom-right-radius: 0;
                    margin-right: 10px;
                }

                    .answer.right .text::before {
                        content: '';
                        display: block;
                        position: absolute;
                        bottom: 0;
                        right: -10px;
                        border-top: 10px solid transparent;
                        border-left: 10px solid #4e73df;
                    }

        .avatar-chat-img {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
        }

        .answer .text img {
            max-width: 70%;
            border-radius: 8px;
            margin-top: 5px;
            display: block;
        }

        .answer.right .text ul, .answer.right .text p {
            color: #fff;
        }

        .answer.right .text strong {
            color: #ffeb3b;
            font-weight: bold;
        }

        .answer.left .text ul {
            padding-left: 20px;
            margin-bottom: 0;
        }

        .answer.left .text p {
            margin-bottom: 0.5rem;
        }

        /* --- 輸入區與快速回覆 --- */
        .chat-input-area {
            padding: 15px;
            background-color: #fff;
            border-top: 1px solid #e3e6f0;
        }

        .quick-reply-area {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            white-space: nowrap;
            margin-bottom: 10px;
            padding-bottom: 5px;
            scrollbar-width: thin;
        }

            .quick-reply-area::-webkit-scrollbar {
                height: 6px;
            }

            .quick-reply-area::-webkit-scrollbar-thumb {
                background-color: #ccc;
                border-radius: 10px;
            }

        .reply-chip {
            border: 1px solid #d1d3e2;
            background-color: #f8f9fc;
            color: #5a5c69;
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }

            .reply-chip:hover {
                background-color: #4e73df;
                color: white;
                border-color: #4e73df;
            }

            .reply-chip:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                background-color: #eaecf4;
            }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<div class="row chat-container mt-4">
    <div class="col-md-3 d-none d-md-block pr-1 chat-col">
        <div class="card shadow mb-4 chat-card">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">對話列表</h6>
            </div>
            <div class="user-list-area">
                @if (Model.Sessions != null)
                {
                    foreach (var session in Model.Sessions)
                    {
                        var isActive = session.ChatSessionId == Model.CurrentChatSessionId ? "active" : "";
                        var displayName = session.User?.Username ?? session.Title ?? "訪客";
                        var listAvatar = !string.IsNullOrEmpty(session.User?.ImageUrl) ? session.User.ImageUrl : "https://duk.tw/ggJM6i.jpg";

                        <a href="@Url.Action("Index", new { id = session.ChatSessionId })" class="session-item @isActive">
                            <img src="@listAvatar" class="avatar-list-img">
                            <div class="chat-item-content">
                                <div class="chat-item-name">@displayName</div>
                                <div class="chat-item-preview" id="session-status-@session.ChatSessionId">
                                    [AI自動回覆]
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-9 col-12 pl-1 chat-col">
        <div class="card shadow mb-4 chat-card">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary mr-2">
                        @if (currentSessionId > 0)
                        {
                            <span>@targetUserName</span>
                        }
                        else
                        {
                            <span>請選擇對話</span>
                        }
                    </h6>
                    <span id="modeBadge" class="badge @(isHumanMode ? "badge-danger" : "badge-success")">
                        @(isHumanMode ? "使用者請求" : "AI自動回覆")
                    </span>
                </div>
            </div>

            <div class="chat-scroll-area" id="chat-content">
                @if (Model.CurrentMessages != null)
                {
                    foreach (var item in Model.CurrentMessages)
                    {
                        var isUser = item.Role == "user";
                        var isRightSide = !isUser;
                        var timeStr = item.CreatedAt; 
                                                      

                        <div class="answer @(isRightSide ? "right" : "left")">
                            <div class="small text-gray-500 mb-1 @(isRightSide ? "text-right" : "")">
                                @if (isUser)
                                {
                                    @targetUserName
                                }
                                else
                                {
                                    @(item.Role == "assistant" ? "AI助手" : "客服")
                                }
                            </div>
                            <div class="d-flex @(isRightSide ? "flex-row-reverse" : "flex-row")">
                                @if (!isRightSide)
                                {
                                    <img src="@targetUserAvatar" class="avatar-chat-img mr-2">
                                }
                                <div class="text">
                                    @Html.Raw(item.Body)
                                </div>
                            </div>
                            <div class="time small text-gray-400 mt-1 @(isRightSide ? "text-right" : "")">@timeStr</div>
                        </div>
                    }
                }
            </div>

            <div class="chat-input-area">
                <div class="quick-reply-area">
                    <button class="reply-chip" onclick="useQuickReply('您好，請問需要什麼協助呢？')">您好，請問需要什麼協助呢？</button>
                    <button class="reply-chip" onclick="useQuickReply('已收到您的訊息，正在為您查詢中')">已收到您的訊息，正在為您查詢中</button>
                    <button class="reply-chip" onclick="useQuickReply('請稍等1–2分鐘，謝謝您的耐心')">請稍等1–2分鐘，謝謝您的耐心</button>
                    <button class="reply-chip" onclick="useQuickReply('很抱歉讓您久等了')">很抱歉讓您久等了</button>
                </div>

                <div class="input-group">
                    <input type="text" id="msgInput" class="form-control bg-light border-0 small" placeholder="輸入回覆..." aria-label="Type message">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" onclick="sendMessage()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentSessionId = @currentSessionId;
        var isHumanMode = @(isHumanMode.ToString().ToLower());
        var connectionId = "";

        // 1. 初始化 SignalR
        const initSignalR = async () => {
             var connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", function (type, message) {
                console.log("後台收到:", type, message);

                var isRightSide = true; // 預設是客服/AI (右邊)
                var senderName = "客服"; // 預設名稱

                // 1. 使用者 (純文字) -> 左邊
                if (type === "User") {
                    isRightSide = false;
                    senderName = "@targetUserName";
                }
                // 2. 使用者 (圖片 + 文字) -> 左邊
                else if (type === "User_Image") {
                    isRightSide = false;
                    senderName = "@targetUserName";

                    // 圖片防呆邏輯
                    if (!message.includes("<img")) {
                        message = `<img src="${message}" style="max-width:100%; border-radius:8px;" />`;
                    }
                }

                else if (type === "System") {
                    senderName = "系統通知";
                    isRightSide = false; // 強制設為左側

                    if (message.includes("AI")) {
                        updateModeUI(false);
                
                        message = `<div class="text-danger">[系統] 使用者已結束對話</div>`;
                    }
                    else if (message.includes("真人")) {
                        updateModeUI(true);
                  
                        message = `<div class="text-danger">[系統] 使用者正在請求客服支援</div>`;
                    }
                    else {
                   
                        message = `<div class="text-danger">${message}</div>`;
                    }
                }
                        // 4. AI (圖片) -> 右邊 (預設)
                        else if (type === "AI_Image") {
                            senderName = "AI助手";
                            if (!message.includes("<img")) {
                                message = `<img src="${message}" style="max-width:100%; border-radius:8px;" />`;
                            }
                        }
                    
                else if (type === "AI") {
                    senderName = "AI助手";
                    message = marked.parse(message);
                }

                // 注意：如果是 "Live" 類型 (客服回覆)，會跑預設值 (isRightSide=true, senderName="客服")

                appendMessage(senderName, message, isRightSide);
            });


            // 監聽使用者求助
            connection.on("ReceiveSupportRequest", function (sessionId, userContent) {
                // 更新左側列表文字
                $("#session-status-" + sessionId).text("[使用者請求中]").css("color", "red").css("font-weight", "bold");

                if (sessionId == currentSessionId) {
                    console.log("收到使用者新訊息！");

                    // ★ 觸發 UI 變更為真人模式 (解鎖輸入)
                    updateModeUI(true);
                } else {
                    console.log("收到其他對話的請求:", sessionId);
                }
            });

            // 監聽模式切換指令 (對應 API Controller)
            connection.on("UpdateModeState", function (sessionId, isHuman) {
                console.log("SignalR 收到模式變更通知 -> Session:", sessionId, " isHuman:", isHuman);

                var listStatusDiv = $("#session-status-" + sessionId);

                if (isHuman) {
                    listStatusDiv.text("[使用者請求中...]").css("color", "red").css("font-weight", "bold");
                } else {
                    listStatusDiv.text("[AI自動回覆中...]").css("color", "").css("font-weight", "");
                }

                // 如果是當前視窗，同步更新上方標頭與輸入框鎖定狀態
                if (currentSessionId && sessionId == currentSessionId) {
                    updateModeUI(isHuman);
                }
            });

            try {
                await connection.start();
                console.log("SignalR Connected ID:", connection.connectionId);
                connectionId = connection.connectionId;

                // 加入客服總機
                await connection.invoke("JoinSupportGroup");

                // 加入專屬房間
                if (currentSessionId > 0) {
                     await connection.invoke("JoinSessionGroup", currentSessionId.toString());
                     console.log("已成功加入監聽房間:", currentSessionId);
                }

            } catch (err) {
                console.error("SignalR Connection Error: ", err);
            }
        };

        $(document).ready(function() {
            scrollToBottom();
            updateModeUI(isHumanMode); // 初始化 UI 狀態 (會執行一次鎖定)
            initSignalR();

            $('#msgInput').keypress(function (e) {
                if (e.which == 13) { sendMessage(); return false; }
            });
        });

        function useQuickReply(text) {
            if ($("#msgInput").prop("disabled")) return;
            var input = $("#msgInput");
            input.val(text);
            input.focus();
        }

        async function sendMessage() {
            if ($("#msgInput").prop("disabled")) {
                return;
            }

            var msg = $("#msgInput").val();
            if (!msg.trim()) return;
            if (currentSessionId === 0) { alert("請先選擇對話"); return; }

            $("#msgInput").val("");

            try {
                const response = await fetch('/api/ChatMessages/AdminReply', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: currentSessionId,
                        userContent: msg,
                        connectionId: connectionId
                    })
                });

                if (!response.ok) {
                    throw new Error("API Error: " + response.statusText);
                }
            } catch (error) {
                console.error("發送失敗:", error);
                appendMessage("系統", `<span class="text-danger">發送失敗: ${error.message}</span>`, true);
            }
        }

        // ★ 更新 UI 模式並控制輸入框鎖定
        function updateModeUI(isHuman) {
            var badge = $("#modeBadge");

            // 呼叫切換輸入框狀態 (重要：這裡會決定是否鎖定)
            toggleInputState(isHuman);

            if (isHuman === true) {
                // 真人模式 (紅色)
                badge.removeClass("badge-success").addClass("badge-danger").text("使用者請求");
            } else {
                // AI 模式 (綠色)
                badge.removeClass("badge-danger").addClass("badge-success").text("AI模式");
            }
        }

        // ★ 控制輸入框與按鈕的啟用/禁用
        function toggleInputState(isEnabled) {
            var input = $("#msgInput");
            var sendBtn = $(".input-group-append button");
            var quickBtns = $(".reply-chip");

            if (isEnabled) {
                // 真人模式：解鎖
                input.prop("disabled", false).attr("placeholder", "輸入回覆...");
                sendBtn.prop("disabled", false);
                quickBtns.prop("disabled", false);
            } else {
                // AI 模式：鎖定 (變灰)
                input.prop("disabled", true).attr("placeholder", "目前為AI模式，無法輸入");
                sendBtn.prop("disabled", true);
                quickBtns.prop("disabled", true);
            }
        }

        function appendMessage(senderName, messageHtml, isRightSide) {
        var now = new Date();
        var year = now.getFullYear();
        var month = (now.getMonth() + 1).toString().padStart(2, '0');
        var day = now.getDate().toString().padStart(2, '0');
        var hours = now.getHours().toString().padStart(2, '0');
        var minutes = now.getMinutes().toString().padStart(2, '0');
        var fullDateTime = `${year}/${month}/${day} ${hours}:${minutes}`;

        var alignClass = isRightSide ? "right" : "left";
        var textAlign = isRightSide ? "text-right" : ""; 
        var flexDir = isRightSide ? "flex-row-reverse" : "flex-row";
        // 這裡使用 Razor 變數 targetUserAvatar 會在 JS 中變成字串
        var avatarUrl = "@targetUserAvatar";
        var avatarHtml = "";

        if (!isRightSide) {
            avatarHtml = `<img src="${avatarUrl}" class="avatar-chat-img mr-2">`;
        }

        var html = `
        <div class="answer ${alignClass}">
            <div class="small text-gray-500 mb-1 ${textAlign}">${senderName}</div>
            <div class="d-flex ${flexDir}">
                ${avatarHtml}
                <div class="text">${messageHtml}</div>
            </div>
            <div class="time small text-gray-400 mt-1 ${textAlign}">${fullDateTime}</div>
        </div>`;

        $("#chat-content").append(html);
        scrollToBottom();
    }

        function scrollToBottom() {
            var chatContent = $("#chat-content");
            chatContent.scrollTop(chatContent.prop("scrollHeight"));
        }

        function escapeHtml(text) {
            if (!text) return "";
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }
    </script>
}