@model incode2.ViewModels.ChatIndexViewModel

@{
    ViewData["Title"] = "客服訊息管理";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentSessionId = Model.CurrentChatSessionId ?? 0;
    var targetUserName = Model.TargetUser?.Username ?? "使用者";

    // 讀取 Controller 傳來的模式狀態
    bool isHumanMode = ViewBag.IsHumanMode ?? false;

    // 使用者頭像
    var targetUserAvatar = !string.IsNullOrEmpty(Model.TargetUser?.ImageUrl)
        ? Model.TargetUser.ImageUrl
        : "https://bootdey.com/img/Content/avatar/avatar1.png";
}

@section Styles {
    <style>
        /* ... (保留原本 CSS 樣式，完全不變) ... */
        .chat-container {
            height: 75vh;
            overflow: hidden;
        }

        .chat-col {
            height: 100%;
        }

        .chat-card {
            height: 100%;
            display: flex;
            flex-direction: column;
            border: 1px solid #e3e6f0;
            overflow: hidden;
        }

        .user-list-area {
            flex: 1;
            overflow-y: auto;
            background-color: #fff;
        }

        .session-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            color: inherit;
            text-decoration: none !important;
        }

            .session-item:hover {
                background-color: #f8f9fc;
            }

            .session-item.active {
                background-color: #e6f0ff;
                border-left: 4px solid #4e73df;
            }

        .avatar-list-img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
        }

        .chat-item-content {
            flex: 1;
            margin-left: 10px;
            overflow: hidden;
        }

        .chat-item-name {
            font-weight: bold;
            color: #5a5c69;
        }

        .chat-item-preview {
            font-size: 0.85rem;
            color: #858796;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-scroll-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background-color: #f8f9fc;
        }

        .answer {
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            max-width: 80%;
        }

            .answer .text {
                padding: 12px 16px;
                border-radius: 1rem;
                font-size: 0.95rem;
                line-height: 1.5;
                position: relative;
                word-wrap: break-word;
                box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            }

            .answer.left {
                align-self: flex-start;
            }

                .answer.left .text {
                    background: #fff;
                    color: #5a5c69;
                    border-bottom-left-radius: 0;
                }

            .answer.right {
                align-self: flex-end;
                margin-left: auto;
            }

                .answer.right .text {
                    background: #4e73df;
                    color: #fff;
                    border-bottom-right-radius: 0;
                }

        .avatar-chat-img {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
        }

        .answer .text img {
            max-width: 100%;
            border-radius: 8px;
            margin-top: 5px;
        }

        .chat-input-area {
            padding: 15px;
            background-color: #fff;
            border-top: 1px solid #e3e6f0;
        }

        .answer.right .text ul, .answer.right .text p {
            color: #fff;
        }

        .answer.right .text strong {
            color: #ffeb3b;
            font-weight: bold;
        }

        .answer.left .text ul {
            padding-left: 20px;
            margin-bottom: 0;
        }

        .answer.left .text p {
            margin-bottom: 0.5rem;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<div class="row chat-container mt-4">
    <div class="col-md-3 col-lg-3 d-none d-md-block pr-1 chat-col">
        <div class="card shadow mb-4 chat-card">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">對話列表</h6>
            </div>
            <div class="user-list-area">
                @if (Model.Sessions != null)
                {
                    foreach (var session in Model.Sessions)
                    {
                        var isActive = session.ChatSessionId == Model.CurrentChatSessionId ? "active" : "";
                        var listName = session.Title ?? "新對話";
                        <a href="@Url.Action("Index", new { id = session.ChatSessionId })" class="session-item @isActive">
                            <img src="@targetUserAvatar" class="avatar-list-img">
                            <div class="chat-item-content">
                                <div class="chat-item-name">@listName</div>
                                <div class="chat-item-preview">
                                    @(session.Ishumanmode ? "🔴 真人請求" : "🤖 AI 託管")
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-9 col-lg-9 col-12 pl-1 chat-col">
        <div class="card shadow mb-4 chat-card">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary mr-2">
                        @if (currentSessionId > 0)
                        {
                            <span>@Model.Sessions?.FirstOrDefault(s => s.ChatSessionId == currentSessionId)?.Title</span>
                        }
                        else
                        {
                            <span>請選擇對話</span>
                        }
                    </h6>
                    <span id="modeBadge" class="badge @(isHumanMode ? "badge-danger" : "badge-success")">
                        @(isHumanMode ? "真人介入中" : "AI 自動回覆")
                    </span>
                </div>
                <div>
                    <span id="connectionStatus" class="badge badge-secondary ml-2">連線中...</span>
                </div>
            </div>

            <div class="chat-scroll-area" id="chat-content">
                @if (Model.CurrentMessages != null)
                {
                    foreach (var item in Model.CurrentMessages)
                    {
                        // 邏輯反轉：後台管理員看畫面
                        // user -> 左邊, assistant/admin -> 右邊
                        var isUser = item.Role == "user";
                        var isRightSide = !isUser;

                        <div class="answer @(isRightSide ? "right" : "left")">
                            <div class="small text-gray-500 mb-1 @(isRightSide ? "text-right" : "")">
                                @if (isUser)
                                {
                                    @targetUserName
                                }
                                else
                                {
                                    @(item.Role == "assistant" ? "AI 助手" : "我 (客服)")
                                }
                            </div>
                            <div class="d-flex @(isRightSide ? "flex-row-reverse" : "flex-row")">
                                @if (!isRightSide)
                                {
                                    <img src="@targetUserAvatar" class="avatar-chat-img mr-2">
                                }
                                <div class="text">
                                    @Html.Raw(item.Body)
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="chat-input-area">
                <div class="input-group">
                    <input type="text" id="msgInput" class="form-control bg-light border-0 small" placeholder="輸入回覆..." aria-label="Type message">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" onclick="sendMessage()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentSessionId = @currentSessionId;
        var isHumanMode = @(isHumanMode.ToString().ToLower());
        var connectionId = ""; // 儲存 SignalR ID

        // 1. 初始化 SignalR
        const initSignalR = async () => {
             var connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            // 監聽接收
            connection.on("ReceiveMessage", function (type, message) {
                console.log("後台收到:", type, message);

                var isRightSide = true;
                var senderName = "我 (客服)";

                if (type === "User_Image") {
                    isRightSide = false;
                    senderName = "@targetUserName";
                    message = `<img src="${message}" style="max-width:200px; border-radius:8px;" />`;
                } else if (type === "System") {
                    senderName = "系統";
                    message = `<i>${message}</i>`;
                    // 更新 UI 狀態
                    if (message.includes("真人")) updateModeUI(true);
                    if (message.includes("AI")) updateModeUI(false);
                } else if (type === "AI_Image") {
                    senderName = "AI 助手";
                    if(!message.startsWith("<")) {
                         message = `<img src="${message}" style="max-width:100%; border-radius:8px;" />`;
                    }
                } else if (type === "AI") {
                    senderName = "AI 助手";
                    message = marked.parse(message);
                }

                appendMessage(senderName, message, isRightSide);
            });

            // ★ 監聽使用者求助訊息 (來自 Controller 的 ReceiveSupportRequest)
            connection.on("ReceiveSupportRequest", function (sessionId, userContent) {
                // 如果是目前打開的對話，直接顯示在左側
                if (sessionId == currentSessionId) {
                    // 如果 userContent 是自動問候語，這裡會顯示出來
                    // 但我們希望這顯示在右邊 (因為是我們/系統發的)
                    // 不過 ReceiveSupportRequest 通常只傳送使用者的訊息
                    // 剛才的 API 修改中，greeting 是透過 ReceiveMessage(Live) 傳給前端，
                    // 並且透過 ReceiveSupportRequest 傳給後端。
                    // 為了避免混淆，我們這裡簡單處理：如果是自動問候語，視為右邊，否則左邊

                    if (userContent === "您好!請問有什麼問題呢?") {
                         appendMessage("系統自動回覆", userContent, true); // 右邊
                    } else {
                         appendMessage("@targetUserName", escapeHtml(userContent), false); // 左邊
                    }
                    console.log("收到使用者/系統新訊息！");
                }
            });

            try {
                await connection.start();
                console.log("SignalR Connected ID:", connection.connectionId);
                connectionId = connection.connectionId;

                // ★ 加入客服群組
                await connection.invoke("JoinSupportGroup");

                $("#connectionStatus").removeClass("badge-secondary").addClass("badge-success").text("連線正常");
            } catch (err) {
                console.error("SignalR Connection Error: ", err);
                $("#connectionStatus").text("連線失敗");
            }
        };

        $(document).ready(function() {
            scrollToBottom();
            initSignalR();

            $('#msgInput').keypress(function (e) {
                if (e.which == 13) { sendMessage(); return false; }
            });
        });

        // 2. 發送訊息 (客服回覆)
        async function sendMessage() {
            var msg = $("#msgInput").val();
            if (!msg.trim()) return;
            if (currentSessionId === 0) { alert("請先選擇對話"); return; }

            // A. 前端立即顯示
            appendMessage("我 (客服)", escapeHtml(msg), true);
            $("#msgInput").val("");

            try {
                // B. 呼叫後端專屬 API: AdminReply
                const response = await fetch('/api/ChatMessages/AdminReply', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: currentSessionId,
                        userContent: msg,
                        connectionId: connectionId
                    })
                });

                if (!response.ok) {
                    throw new Error("API 回傳錯誤: " + response.statusText);
                }
            } catch (error) {
                console.error("發送失敗:", error);
                appendMessage("系統", `<span class="text-danger">發送失敗: ${error.message}</span>`, true);
            }
        }

        // ★ 已移除 toggleHumanMode 函式，因為按鈕已刪除 ★

        function updateModeUI(isHuman) {
            var badge = $("#modeBadge");
            // 這裡不再操作 btnSwitchMode，因為它已經被移除了

            if (isHuman) {
                badge.removeClass("badge-success").addClass("badge-danger").text("真人介入中");
            } else {
                badge.removeClass("badge-danger").addClass("badge-success").text("AI 自動回覆");
            }
        }

        function appendMessage(senderName, messageHtml, isRightSide) {
            var timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            var alignClass = isRightSide ? "right" : "left";
            var textRightClass = isRightSide ? "text-right" : "";
            var flexDirClass = isRightSide ? "flex-row-reverse" : "flex-row";

            var avatarHtml = !isRightSide ? `<img src="@targetUserAvatar" class="avatar-chat-img mr-2">` : "";

            var html = `
                <div class="answer ${alignClass}">
                    <div class="small text-gray-500 mb-1 ${textRightClass}">${senderName}</div>
                    <div class="d-flex ${flexDirClass}">
                        ${avatarHtml}
                        <div class="text">${messageHtml}</div>
                    </div>
                    <div class="time ${textRightClass}">${timeNow}</div>
                </div>`;

            $("#chat-content").append(html);
            scrollToBottom();
        }

        function scrollToBottom() {
            var chatContent = $("#chat-content");
            chatContent.scrollTop(chatContent.prop("scrollHeight"));
        }

        function escapeHtml(text) {
            if (!text) return "";
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }
    </script>
}