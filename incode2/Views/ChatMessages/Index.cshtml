@model incode2.ViewModels.ChatIndexViewModel

@{
    ViewData["Title"] = "聊天室";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentSessionId = Model.CurrentChatSessionId ?? 0;
    var targetUserName = Model.TargetUser?.Username ?? "使用者";
    // 讀取 Controller 傳來的模式狀態 (預設 false = AI)
    bool isHumanMode = ViewBag.IsHumanMode ?? false;

    var targetUserAvatar = !string.IsNullOrEmpty(Model.TargetUser?.ImageUrl)
        ? Model.TargetUser.ImageUrl
        : "https://bootdey.com/img/Content/avatar/avatar1.png";
}

@section Styles {
    <style>
        .chat-container {
            height: 75vh;
            overflow: hidden;
        }

        .chat-col {
            height: 100%;
        }

        .chat-card {
            height: 100%;
            display: flex;
            flex-direction: column;
            border: 1px solid #e3e6f0;
            overflow: hidden;
        }

        /* 列表樣式 */
        .user-list-area {
            flex: 1;
            overflow-y: auto;
            background-color: #fff;
        }

        .session-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            color: inherit;
            text-decoration: none !important;
        }

            .session-item:hover {
                background-color: #f8f9fc;
            }

            .session-item.active {
                background-color: #e6f0ff;
                border-left: 4px solid #4e73df;
            }

        .avatar-list-img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
        }

        .chat-item-content {
            flex: 1;
            margin-left: 10px;
            overflow: hidden;
        }

        .chat-item-name {
            font-weight: bold;
            color: #5a5c69;
        }

        .chat-item-preview {
            font-size: 0.85rem;
            color: #858796;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* 聊天區樣式 */
        .chat-scroll-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background-color: #f8f9fc;
        }

        .answer {
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            max-width: 80%;
        }

            .answer .text {
                padding: 12px 16px;
                border-radius: 1rem;
                font-size: 0.95rem;
                line-height: 1.5;
                position: relative;
                word-wrap: break-word;
                box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            }

            /* 左側 (對方/AI) */
            .answer.left {
                align-self: flex-start;
            }

                .answer.left .text {
                    background: #fff;
                    color: #5a5c69;
                    border-bottom-left-radius: 0;
                }

            /* 右側 (我) */
            .answer.right {
                align-self: flex-end;
                margin-left: auto;
            }

                .answer.right .text {
                    background: #4e73df;
                    color: #fff;
                    border-bottom-right-radius: 0;
                }

        .avatar-chat-img {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
        }

        .answer .text img {
            max-width: 100%;
            border-radius: 8px;
            margin-top: 5px;
        }

        /* 輸入區 */
        .chat-input-area {
            padding: 15px;
            background-color: #fff;
            border-top: 1px solid #e3e6f0;
        }

        /* Markdown 樣式修正 */
        .answer.left .text ul {
            padding-left: 20px;
            margin-bottom: 0;
        }

        .answer.left .text p {
            margin-bottom: 0.5rem;
        }

            .answer.left .text p:last-child {
                margin-bottom: 0;
            }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<div class="row chat-container mt-4">
    <div class="col-md-3 col-lg-3 d-none d-md-block pr-1 chat-col">
        <div class="card shadow mb-4 chat-card">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">歷史對話</h6>
            </div>
            <div class="user-list-area">
                @if (Model.Sessions != null)
                {
                    foreach (var session in Model.Sessions)
                    {
                        var isActive = session.ChatSessionId == Model.CurrentChatSessionId ? "active" : "";
                        var listName = session.Title ?? "新對話";
                        <a href="@Url.Action("Index", new { id = session.ChatSessionId })" class="session-item @isActive">
                            <img src="@targetUserAvatar" class="avatar-list-img">
                            <div class="chat-item-content">
                                <div class="chat-item-name">@listName</div>
                                <div class="chat-item-preview">
                                    @(session.Ishumanmode ? "[真人對話中]" : "[AI 助理]")
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-9 col-lg-9 col-12 pl-1 chat-col">
        <div class="card shadow mb-4 chat-card">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary mr-2">
                        @if (currentSessionId > 0)
                        {
                            <span>@Model.Sessions?.FirstOrDefault(s => s.ChatSessionId == currentSessionId)?.Title</span>
                        }
                        else
                        {

                            <span>請選擇對話</span>
                        }
                    </h6>
                    <span id="modeBadge" class="badge @(isHumanMode ? "badge-warning" : "badge-info")">
                        @(isHumanMode ? "真人客服" : "AI 助理")
                    </span>
                </div>
                <div>
                    @if (currentSessionId > 0)
                    {
                        <button id="btnSwitchMode" class="btn btn-sm @(isHumanMode ? "btn-danger" : "btn-warning")" onclick="toggleHumanMode()">
                            @(isHumanMode ? "結束對話 (轉回 AI)" : "呼叫真人客服")
                        </button>
                    }
                    <span id="connectionStatus" class="badge badge-secondary ml-2">連線中...</span>
                </div>
            </div>

            <div class="chat-scroll-area" id="chat-content">
                @if (Model.CurrentMessages != null)
                {
                    foreach (var item in Model.CurrentMessages)
                    {
                        var isUser = item.Role == "user";
                        // 判斷是否為系統/管理員/AI (顯示在左側，使用者自己在右側)
                        // 注意：這裡假設這是「使用者端」介面。如果是「後台管理端」，邏輯要反過來。
                        // 根據你的需求 "使用者觸發真人按鈕"，這應該是使用者介面。
                        // 使用者發的 (User) -> 右邊
                        // 別人發的 (Assistant, Admin) -> 左邊
                        var isRightSide = isUser;

                        <div class="answer @(isRightSide ? "right" : "left")">
                            <div class="small text-gray-500 mb-1 @(isRightSide ? "text-right" : "")">
                                @(isUser ? "我" : (item.Role == "assistant" ? "AI 助手" : "客服人員"))
                            </div>
                            <div class="d-flex @(isRightSide ? "flex-row-reverse" : "flex-row")">
                                @if (!isRightSide)
                                {
                                    <img src="@targetUserAvatar" class="avatar-chat-img mr-2">
                                }
                                <div class="text">
                                    @Html.Raw(item.Body)
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="chat-input-area">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('imageInput').click()">
                            <i class="fas fa-image"></i>
                        </button>
                    </div>
                    <input type="file" id="imageInput" accept="image/*" style="display: none;" onchange="uploadImage(this)">

                    <input type="text" id="msgInput" class="form-control bg-light border-0 small" placeholder="輸入訊息..." aria-label="Type message">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" onclick="sendMessage()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 初始化變數
        var currentSessionId = @currentSessionId;
        var isHumanMode = @(isHumanMode.ToString().ToLower()); // C# bool 轉 JS boolean
        var connectionId = ""; // SignalR ID

        // 1. 初始化 SignalR
        const initSignalR = async () => {
             var connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect({
                    nextRetryDelayInMilliseconds: retryContext => 5000 // 失敗等待 5 秒重試
                })
                .build();

            // 設置逾時參數
            connection.serverTimeoutInMilliseconds = 30 * 60 * 1000;
            connection.keepAliveIntervalInMilliseconds = 15 * 1000;

            // 綁定接收事件
            connection.on("ReceiveMessage", function (type, message) {
                // type: "AI", "AI_Image", "User_Image", "System", "Live"
                console.log("收到訊息:", type, message);

                var isRightSide = false; // 接收到的訊息都在左邊
                var senderName = "AI 助手";

                if (type === "User_Image") {
                    // 這是使用者剛剛上傳的圖片回顯，顯示在右邊
                    isRightSide = true;
                    senderName = "我";
                    message = `<img src="${message}" style="max-width:200px; border-radius:8px;" />`;
                } else if (type === "System") {
                    // 系統通知 (例如切換模式)
                    // 可以用 Toast 或中間的小灰字顯示，這裡簡單處理
                    senderName = "系統通知";
                    message = `<i>${message}</i>`;
                } else if (type === "AI_Image") {
                    // AI 生成的圖片
                    // message 本身就是 <img> 標籤 (後端處理過了) 或者 URL
                    // 如果後端傳的是純 URL:
                    if(!message.startsWith("<")) {
                         message = `<img src="${message}" style="max-width:100%; border-radius:8px;" />`;
                    }
                } else {
                    // AI 純文字 -> 解析 Markdown
                    message = marked.parse(message);
                }

                if (isHumanMode && type !== "System" && !isRightSide) {
                    senderName = "客服人員";
                }

                appendMessage(senderName, message, isRightSide);
            });

            try {
                await connection.start();
                console.log("SignalR Connected. ID:", connection.connectionId);
                connectionId = connection.connectionId;
                $("#connectionStatus").removeClass("badge-secondary").addClass("badge-success").text("連線正常");
            } catch (err) {
                console.error("SignalR Connection Error: ", err);
                $("#connectionStatus").text("連線失敗");
                setTimeout(initSignalR, 5000); // 失敗重連
            }
        };

        $(document).ready(function() {
            scrollToBottom();
            initSignalR();

            // 綁定 Enter 鍵
            $('#msgInput').keypress(function (e) {
                if (e.which == 13) {
                    sendMessage();
                    return false;
                }
            });
        });

        // 2. 發送文字訊息 API
        async function sendMessage() {
            var msg = $("#msgInput").val();
            if (!msg.trim()) return;
            if (currentSessionId === 0) { alert("請先建立或選擇對話"); return; }

            // 立即顯示自己的訊息在右側
            appendMessage("我", escapeHtml(msg), true);
            $("#msgInput").val("");

            try {
                const response = await fetch('/api/ChatMessages/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: currentSessionId,
                        userContent: msg,
                        connectionId: connectionId
                    })
                });

                if (!response.ok) throw new Error("API Error");
                // 後端會透過 SignalR 回傳 AI 的回應，所以這裡不用處理 response.json() 的內容

            } catch (error) {
                console.error("發送失敗:", error);
                appendMessage("系統", "<span class='text-danger'>發送失敗，請稍後再試。</span>", false);
            }
        }

        // 3. 上傳圖片 API
        async function uploadImage(input) {
            if (input.files && input.files[0]) {
                var file = input.files[0];
                var formData = new FormData();
                formData.append("SessionId", currentSessionId);
                formData.append("Image", file);
                formData.append("ConnectionId", connectionId);

                // 顯示「上傳中...」
                appendMessage("系統", "<i>圖片上傳分析中...</i>", false);

                try {
                    const response = await fetch('/api/ChatMessages/UploadImage', {
                        method: 'POST',
                        body: formData // FormData 不需要設定 Content-Type，瀏覽器會自動處理
                    });

                    if (!response.ok) throw new Error("Upload Failed");
                    // 成功後，SignalR 會推播 User_Image (顯示圖片) 和 AI (顯示分析結果)
                } catch (error) {
                    console.error("上傳失敗:", error);
                    appendMessage("系統", "<span class='text-danger'>圖片上傳失敗。</span>", false);
                }

                // 清空 input 讓同一張圖可以再次上傳
                input.value = '';
            }
        }

        // 4. 切換 真人/AI 模式 API
        async function toggleHumanMode() {
            if (currentSessionId === 0) return;

            // 切換狀態：如果是真人(true) -> 改為 AI(false)，反之亦然
            var newMode = !isHumanMode;

            try {
                const response = await fetch('/api/ChatMessages/SwitchMode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: currentSessionId,
                        ishumanmode: newMode,
                        connectionId: connectionId
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    // 更新全域變數與 UI
                    isHumanMode = newMode;
                    updateModeUI();
                } else {
                    alert("切換模式失敗");
                }
            } catch (error) {
                console.error("Switch Mode Error:", error);
            }
        }

        function updateModeUI() {
            var badge = $("#modeBadge");
            var btn = $("#btnSwitchMode");

            if (isHumanMode) {
                badge.removeClass("badge-info").addClass("badge-warning").text("真人客服");
                btn.removeClass("btn-warning").addClass("btn-danger").text("結束對話 (轉回 AI)");
            } else {
                badge.removeClass("badge-warning").addClass("badge-info").text("AI 助理");
                btn.removeClass("btn-danger").addClass("btn-warning").text("呼叫真人客服");
            }
        }

        // 輔助功能
        function appendMessage(senderName, messageHtml, isRightSide) {
            var timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            var alignClass = isRightSide ? "right" : "left";
            var textRightClass = isRightSide ? "text-right" : "";
            var flexDirClass = isRightSide ? "flex-row-reverse" : "flex-row";
            var avatarUrl = "@targetUserAvatar"; // 這裡可以根據 senderName 換不同頭像

            var avatarHtml = !isRightSide ? `<img src="${avatarUrl}" class="avatar-chat-img mr-2">` : "";

            var html = `
                <div class="answer ${alignClass}">
                    <div class="small text-gray-500 mb-1 ${textRightClass}">${senderName}</div>
                    <div class="d-flex ${flexDirClass}">
                        ${avatarHtml}
                        <div class="text">${messageHtml}</div>
                    </div>
                    <div class="time ${textRightClass}">${timeNow}</div>
                </div>`;

            $("#chat-content").append(html);
            scrollToBottom();
        }

        function scrollToBottom() {
            var chatContent = $("#chat-content");
            chatContent.scrollTop(chatContent.prop("scrollHeight"));
        }

        function escapeHtml(text) {
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }
    </script>
}