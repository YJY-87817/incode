@model incode2.Models.ShippedDetail

@{
    ViewData["Title"] = "寄送管理";
}

<h2>刪除</h2>

<div class="col-6">
    <form asp-action="Delete">
        <div class="mb-3">
            <input type="hidden" asp-for="ShippedDetailId" />
            <label asp-for="OrderdetailId" class="form-label fw-bold">需寄送訂單詳細ID:</label>
            <input asp-for="OrderdetailId" type="number" class="form-control" required>
        </div>
        <div class="mb-3">
            <label asp-for="RecipientName" class="form-label fw-bold">收件人名稱:</label>
            <input asp-for="RecipientName" class="form-control" required>
        </div>
        <div class="mb-3">
            <label asp-for="RecipientAddress" class="form-label fw-bold">收件人地址:</label>
            <input asp-for="RecipientAddress" class="form-control" required>
        </div>
        <div class="mb-3">
            <label asp-for="RecipientPhone" class="form-label fw-bold">收件人電話:</label>
            <input asp-for="RecipientPhone" class="form-control" required>
        </div>
        <div class="mb-3">
            <label asp-for="ShippedDate" class="form-label fw-bold">寄送日期:</label>
            <input asp-for="ShippedDate" class="form-control">
        </div>
        <div class="mb-3">
            <label asp-for="ArrivalDate" class="form-label fw-bold">送達日期:</label>
            <input asp-for="ArrivalDate" class="form-control">
        </div>
        <div class="mb-3">
            <label asp-for="Remark" class="form-label fw-bold">備註:</label>
            <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3 d-flex gap-4">
            <div class="form-check">
                <input asp-for="IsFailed" class="form-check-input" type="checkbox">
                <label asp-for="IsFailed" class="form-check-label">寄送失敗</label>
            </div>
            <div class="form-check">
                <input asp-for="IsCompleted" class="form-check-input" type="checkbox">
                <label asp-for="IsCompleted" class="form-check-label">是否完成</label>
            </div>
        </div>
        <div class="d-grid gap-2 mt-4">
            <button id="BtnDelete" type="submit" class="btn btn-primary">刪除</button>
        </div>
    </form>
</div>