@model incode2.Models.ShippedDetail

@{
    ViewData["Title"] = "刪除寄送資料";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="alert alert-warning d-flex align-items-center mb-4 shadow-sm border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
                <div>
                    <h5 class="alert-heading mb-1 fw-bold text-danger">危險操作確認</h5>
                    <p class="mb-0 small text-dark">您即將刪除收件人 <strong>@Model.RecipientName</strong> 的寄送紀錄。</p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form id="deleteForm" asp-action="Delete">
                        <input type="hidden" asp-for="ShippedDetailId" />

                        <div class="list-group list-group-flush mb-4">
                            <div class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                                <span class="text-muted">訂單ID</span>
                                <span class="fw-bold">#@Model.OrderId</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                                <span class="text-muted">收件人</span>
                                <span class="fw-bold">@Model.RecipientName</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                                <span class="text-muted">電話</span>
                                <span class="fw-bold">@Model.RecipientPhone</span>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <a href="@Url.Action("Index")" class="btn btn-light w-100 border">取消</a>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-danger w-100 fw-bold" onclick="confirmDelete()">
                                    <i class="bi bi-trash me-1"></i> 確認刪除
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">最後確認</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-exclamation-circle text-danger display-4 mb-3"></i>
                <p class="fs-5">確定要永久刪除此資料嗎？<br><small class="text-muted">此動作無法復原</small></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">我再想想</button>
                <button type="button" class="btn btn-danger px-4" onclick="executeSubmit()">是的，刪除它</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 初始化 Modal
        let myModal;
        document.addEventListener('DOMContentLoaded', function() {
            myModal = new bootstrap.Modal(document.getElementById('confirmModal'));
        });

        // 觸發彈窗
        function confirmDelete() {
            myModal.show();
        }

        // 真正執行表單送出
        function executeSubmit() {
            document.getElementById('deleteForm').submit();
        }
    </script>
}