@model IEnumerable<incode2.Models.ContentHistory>

@{
  ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
  <a asp-action="Create">Create New</a>
</p>
<table class="table">
  <thead>
    <tr>
      <th>
        @Html.DisplayNameFor(model => model.OldTitle)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.OldBody)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.Ishidden)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.EditedAt)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.Content)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.User)
      </th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var item in Model)
    {
      <tr>
        <td>
          @Html.DisplayFor(modelItem => item.OldTitle)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.OldBody)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.Ishidden)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.EditedAt)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.Content.Body)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.User.Account)
        </td>
        <td>
          <a asp-action="Edit" asp-route-id="@item.ContentHistoryId">Edit</a> |
          <a asp-action="Details" asp-route-id="@item.ContentHistoryId">Details</a> |
          <a asp-action="Delete" asp-route-id="@item.ContentHistoryId">Delete</a>
        </td>
      </tr>
    }
  </tbody>
</table>

@section Scripts {
  <script>
    $(document).ready(function(){
        alert("Hello MVC");
    })
  </script>
}
