@model IEnumerable<ContentHistory>

@{
  ViewData["Title"] = "Index";
}

@section Styles
{
  <link href="~/css/table.min.css" rel="stylesheet" />
  <style>
  </style>
}
<h1>Index</h1>

<p>
  <a class="btn btn-primary" title="新增商品紀錄" asp-action="Create">新增</a>
</p>
<table class="table table-striped table-bordered table-hover table-responsive">
  <thead class="table-primary">
    <tr>
      <th>
        @Html.DisplayNameFor(model => model.ContentHistoryId)
      </th>
      <th>
        @* @Html.是舊的TaqHelper，但還是可以用
          DisplayNameFor 顯示欄位標題，要在controller裡面用[Display]屬性來設定
        *@
        @Html.DisplayNameFor(model => model.OldTitle)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.OldBody)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.Ishidden)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.EditedAt)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.User)
      </th>
      <th>操作項目</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var item in Model)
    {
      <tr>
        <td>
          @Html.DisplayFor(modelItem => item.ContentHistoryId)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.OldTitle)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.OldBody)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.Ishidden)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.EditedAt)
        </td>
        <td>
                    @Html.DisplayFor(modelItem => item.User.Email)
        </td>
        <td>
          <a asp-controller="ContentHistory" asp-action="Edit" asp-route-content_history_id="@item.ContentHistoryId">Edit</a> |
          <a asp-controller="ContentHistory" asp-action="Details" asp-route-content_history_id="@item.ContentHistoryId">Details</a> |
          <a asp-controller="ContentHistory" asp-action="Delete" asp-route-content_history_id="@item.ContentHistoryId">Delete</a>
        </td>
      </tr>
    }
  </tbody>
</table>

@section Scripts {
  <script>
    // $(document).ready(function(){
    //     alert("Hello MVC");
    // })
  </script>
}
