@model IEnumerable<ContentViewModel>

@{
  ViewBag.Title = "貼文列表";
  ViewBag.PageHeading = "討論區";
}

<div class="card shadow mb-4">
  <div class="card-header py-3">
    <h6 class="m-0 font-weight-bold text-primary">所有貼文</h6>
  </div>
  <div class="card-body">

    <!-- 新增貼文按鈕 -->
    <a asp-action="Create" class="btn btn-success mb-3">
      <i class="fas fa-plus"></i> 新增貼文
    </a>

    <!-- 貼文列表 -->
    <div class="table-responsive">
      <table class="table table-bordered" width="100%">
        <thead>
          <tr>
            <th>@Html.DisplayNameFor(s => s.ContentId)</th>
            <th>@Html.DisplayNameFor(s => s.ParentContentId)</th>
            <th>內容預覽</th>
            <th>作者</th>
            <th>分類</th>
            <th>發布時間</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model)
          {
            <tr>
              <td>
                <strong>@Html.DisplayFor(s => item.ContentId)</strong>
              </td>
              <td>
                <strong>@Html.DisplayFor(s => item.ParentContentId)</strong>
              </td>
              <td>
                @item.Body...
              </td>
              <td>
                <i class="fas fa-user"></i> @item.AuthorName
              </td>
              <td>
                <span class="badge badge-primary">@item.CategoryName</span>
              </td>
              <td>
                @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")
              </td>
              <td>
                <a asp-action="Details" asp-route-id="@item.ContentId"
                   class="btn btn-info btn-sm">
                  <i class="fas fa-eye"></i> 查看
                </a>
              </td>
            </tr>
          }

        </tbody>
      </table>
    </div>

    @if (!Model.Any())
    {
      <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> 目前還沒有任何貼文
      </div>
    }

  </div>
</div>