@model incode.MVC.Models.PointRecharge

@{
    ViewData["Title"] = "點數儲值修改";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning py-3">
                    <h4 class="mb-0 fs-5 fw-bold text-dark">
                        <i class="fas fa-edit me-2"></i>點數儲值修改
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" id="editForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="PointRechargeId" />

                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="UserId" />

                        <div class="row mb-4 p-3 bg-light rounded">
                            <div class="col-md-6">
                                <label class="text-muted fw-bold small">訂單編號</label>
                                <div class="fw-bold">@Model.OrderNo</div>
                                <input type="hidden" asp-for="OrderNo" />
                            </div>
                            <div class="col-md-6 text-md-end">
                                <label class="text-muted fw-bold small">建立時間</label>
                                <div class="fw-bold">@Model.CreatedAt</div>
                            </div>
                            <div class="col-md-12 mt-2">
                                <label class="text-muted fw-bold small">會員 Email</label>
                                <div class="fw-bold">@Model.User?.Email</div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CashAmount" class="form-label fw-bold text-primary">儲值金額 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="CashAmount" class="form-control" type="number" step="0.01" required />
                                </div>
                                <span asp-validation-for="CashAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PointsGranted" class="form-label fw-bold text-success">獲得點數 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">P</span>
                                    <input asp-for="PointsGranted" class="form-control" type="number" required />
                                </div>
                                <span asp-validation-for="PointsGranted" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PaymentMethod" class="form-label fw-bold">支付方式</label>
                                <input asp-for="PaymentMethod" class="form-control" />
                                <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PaymentTradeNo" class="form-label fw-bold">支付交易號</label>
                                <input asp-for="PaymentTradeNo" class="form-control" />
                                <span asp-validation-for="PaymentTradeNo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 mb-4">
                                <label asp-for="Status" class="form-label fw-bold">狀態</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="pending">待處理</option>
                                    <option value="success">成功</option>
                                    <option value="failed">失敗</option>
                                    <option value="cancelled">已取消</option>
                                    <option value="system">系統操作</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-warning px-5 fw-bold shadow-sm text-dark">
                                <i class="fas fa-save me-1"></i> 儲存修改
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> 返回列表
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}