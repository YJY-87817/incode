@model IEnumerable<incode.MVC.Models.PointRecharge>

@{
    ViewData["Title"] = "點數儲值管理";
}

<div class="container-fluid py-4">
    <partial name="_TempDataAlert" />
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-dollar-sign text-primary me-2"></i>點數儲值紀錄
        </h1>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">儲值明細列表</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.OrderNo)</th>
                            <th>@Html.DisplayNameFor(model => model.CashAmount)</th>
                            <th>@Html.DisplayNameFor(model => model.PointsGranted)</th>
                            <th>@Html.DisplayNameFor(model => model.PaymentMethod)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                            <th>會員 Email</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.OrderNo)</td>
                                <td>@item.CashAmount.ToString("C0")</td>
                                <td class="fw-bold">@item.PointsGranted.ToString("N0")</td>
                                <td>@Html.DisplayFor(modelItem => item.PaymentMethod)</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "success":
                                            <span class="badge bg-success">成功</span>
                                            break;
                                        case "pending":
                                            <span class="badge bg-warning text-dark">處理中</span>
                                            break;
                                        case "failed":
                                            <span class="badge bg-danger">失敗</span>
                                            break;
                                        case "cancelled":
                                            <span class="badge bg-secondary">已取消</span>
                                            break;
                                        case "system":
                                            <span class="badge bg-info text-dark">系統操作</span>
                                            break;
                                        default:
                                            <span class="badge bg-dark">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td>@item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @{
                                        // 處理 Email，只顯示 @ 前面的部分
                                        var emailPrefix = item.User?.Email?.Split('@')[0] ?? "N/A";
                                    }
                                    @emailPrefix
                                </td>
                                <td>
                                    @* 待付款 / 失敗：會員付款了但綠界通知沒進來時人工補單（會加點，不會重複） *@
                                    @if (item.Status == "pending" || item.Status == "failed")
                                    {
                                        <form method="post" asp-action="Complete" asp-route-id="@item.PointRechargeId" class="d-flex gap-1">
                                            <input name="paymentTradeNo" class="form-control form-control-sm" required
                                                   maxlength="@PointLogService.MaxManualTradeNoLength" placeholder="綠界交易編號或補單備註" />
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap"
                                                    onclick="return confirm('確認會員已付款？補單會把儲值單改為成功並加 @item.PointsGranted.ToString("N0") 點。')">人工補單</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 初始化 DataTables
            $('#dataTable').DataTable({
                "language": {
                    "url": "@Url.Content("~/lib/datatables/i18n/zh-HANT.json")"
                },
                "order": [[5, "desc"]] // 預設依建立時間倒序排序
            });
        });
    </script>
}