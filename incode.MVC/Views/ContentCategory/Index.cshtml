@section Styles
{
  <style>

  </style>
}

<table class="table table-hover table-striped">
  <thead class="table-danger">
    <tr>
      <th>content_category_id</th>
      <th>parent_category_id</th>
      <th>category_name</th>
      <th>description</th>
    </tr>
  </thead>
</table>

@section Scripts
{
  <script src="~/lib/datatables/dataTables.fixedHeader.min.js"></script>
  <script>
    $("table").dataTable({
      ajax:{
        type:"POST",
        url: "@Url.Action("IndexJson", "ContentCategory")", // 原本寫死 https://localhost:7190，其他網址的環境載不到資料
        dataSrc:function(data){
          return data;
        }
      },
      columns:[
        {data:"contentCategoryId",width:"20%"},
        {data:"parentCategoryId",width:"20%"},
        {data:"categoryName",width:"20%"},
        {data:"description",width:"20%"},
      ],
      fixedHeader:
      {
        header:true,
      },
      language: {
        url: '@Url.Content("~/lib/datatables/i18n/zh-HANT.json")',
      },
    })
  </script>
}