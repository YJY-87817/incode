@section Styles
{
  <style>

  </style>
}

<div class="container-fluid py-4">
  <partial name="_TempDataAlert" />
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0 text-gray-800">論壇分類</h1>
    <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm"><i class="fas fa-plus fa-sm text-white-50"></i> 新增分類</a>
  </div>
  <table class="table table-hover table-striped" id="categoryTable">
    <thead class="table-danger">
      <tr>
        <th>ID</th>
        <th>父分類 ID</th>
        <th>名稱</th>
        <th>說明</th>
        <th>狀態</th>
        <th>操作</th>
      </tr>
    </thead>
  </table>
</div>

@section Scripts
{
  <script src="~/lib/datatables/dataTables.fixedHeader.min.js"></script>
  <script>
    // 分類名稱 / 說明可以由會員在前台新增：一律以純文字輸出（DataTables 預設把資料當 HTML 插入，會執行會員寫入的標籤）
    const text = $.fn.dataTable.render.text();
    const base = "@Url.Content("~/ContentCategory/")";
    $("#categoryTable").dataTable({
      ajax:{
        type:"POST",
        url: "@Url.Action("IndexJson", "ContentCategory")", // 原本寫死 https://localhost:7190，其他網址的環境載不到資料
        dataSrc:function(data){
          return data;
        }
      },
      columns:[
        {data:"contentCategoryId",width:"8%"},
        {data:"parentCategoryId",width:"10%",defaultContent:""},
        {data:"categoryName",width:"25%",render:text},
        {data:"description",width:"30%",render:text,defaultContent:""},
        {data:"status",width:"10%",render:text},
        {data:"contentCategoryId",orderable:false,searchable:false,render:function(id){
          id = parseInt(id, 10);
          return '<a class="btn btn-sm btn-outline-info" href="' + base + 'Details/' + id + '">詳情</a> '
            + '<a class="btn btn-sm btn-outline-primary" href="' + base + 'Edit/' + id + '">編輯</a> '
            + '<a class="btn btn-sm btn-outline-danger" href="' + base + 'Delete/' + id + '">刪除</a>';
        }},
      ],
      fixedHeader:
      {
        header:true,
      },
      language: {
        url: '@Url.Content("~/lib/datatables/i18n/zh-HANT.json")',
      },
    })
  </script>
}