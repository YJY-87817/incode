{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "font-awesome@7.0.1",
      "destination": "wwwroot/lib/font-awesome/"
    },
    {
      "library": "Chart.js@4.5.0",
      "destination": "wwwroot/lib/chart.js/",
      "files": [
        "chart.umd.min.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "dompurify@3.4.17",
      "destination": "wwwroot/lib/dompurify/",
      "files": [
        "dist/purify.min.js",
        "LICENSE"
      ]
    },
    {
      "provider": "cdnjs",
      "library": "datatables@1.13.7",
      "destination": "wwwroot/lib/datatables/"
    }
  ]
}