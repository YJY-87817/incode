{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // 不記錄 SQL 內容（含會員資料）與框架的細節
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          // 每天一個檔案，保留 30 天；路徑相對於專案目錄，正式環境請設成部署資料夾以外的絕對路徑
          "path": "logs/incode-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ]
  },
  "EmailSettings": {
    "MailServer": "smtp.gmail.com",
    "MailPort": "587",
    "SenderName": "Incode 官方",
    "SenderEmail": "incode2026@gmail.com",
    "Password": ""
  },
  "AllowedHosts": "*",
  "GeminiApiKey": "",
  "TmdbApiKey": "",
  "imgapikey": "",
